<Project Sdk="Microsoft.NET.Sdk">

  <!-- Headless Avalonia tests run in their own process: the UI dispatcher binds to one thread per process. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="RenderHarness.fs" />
    <Compile Include="DiffSurfaceTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="12.1.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="Unquote" Version="7.0.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GitKay.Core\GitKay.Core.fsproj" />
    <ProjectReference Include="..\..\src\GitKay.UI\GitKay.UI.csproj" />
  </ItemGroup>

</Project>
