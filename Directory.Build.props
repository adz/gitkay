<Project>
  <PropertyGroup>
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
    <AxialGuardrailsSeverity>error</AxialGuardrailsSeverity>

    <!-- Local/dev default only; the release workflow stamps the real version via -p:Version from the release tag. -->
    <VersionPrefix>0.16.0</VersionPrefix>
    <Authors>Adam Davies</Authors>
    <Product>GitKay</Product>
    <RepositoryUrl>https://github.com/adz/gitkay</RepositoryUrl>

    <!--
      This dogfood branch uses the local NuGet package by default. Opt into a source checkout
      explicitly with -p:UseLocalGlue=source and -p:GlueSourceRoot=<path>.
    -->
    <ElmishGlueVersion>0.2.0</ElmishGlueVersion>
    <GlueSourceRoot Condition="'$(GlueSourceRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\Elmish.Avalonia.Glue\main\</GlueSourceRoot>
    <UseLocalGlue Condition="'$(UseLocalGlue)' == 'source' and '$(CI)' != 'true' and Exists('$(GlueSourceRoot)src')">true</UseLocalGlue>
  </PropertyGroup>
</Project>
