<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Diagnostics.fs" />
    <Compile Include="Models.fs" />
    <Compile Include="FileChange.fs" />
    <Compile Include="CommitFormat.fs" />
    <Compile Include="DiffFind.fs" />
    <Compile Include="Settings.fs" />
    <Compile Include="DiffRows.fs" />
    <Compile Include="DiffNavigation.fs" />
    <Compile Include="DiffExpansion.fs" />
    <Compile Include="Vim.fs" />
    <Compile Include="Graph.fs" />
    <Compile Include="Git\Error.fs" />
    <Compile Include="Git\Internal\RepositoryDiscovery.fs" />
    <Compile Include="Git\Search.fs" />
    <Compile Include="Git\WorkingTree.fs" />
    <Compile Include="Git\PatchBuilder.fs" />
    <Compile Include="Git\Trash.fs" />
    <Compile Include="Git\Startup.fs" />
    <Compile Include="Git\Parsing.fs" />
    <Compile Include="Git\Internal\History.fs" />
    <Compile Include="GitService.fs" />
    <Compile Include="App.fs" />
    <Compile Include="CommitWindow.fs" />
    <Compile Include="SelfTest.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Axial.Elmish\Axial.Elmish.fsproj" />
    <ProjectReference Include="..\GitKay.Kit\GitKay.Kit.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Axial" Version="0.9.3" />
    <PackageReference Include="Axial.Console" Version="0.9.3" />
    <PackageReference Include="Axial.FileSystem" Version="0.9.3" />
    <PackageReference Include="Axial.PlatformService" Version="0.9.3" />
    <PackageReference Include="Axial.Process" Version="0.9.3" />
    <PackageReference Include="Reified" Version="0.8.2" />
    <PackageReference Include="Axial.Guardrails" Version="0.9.3" PrivateAssets="all" />
    <PackageReference Include="LibGit2Sharp" Version="0.32.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalGlue)' == 'true'">
    <ProjectReference Include="$(GlueSourceRoot)src\Elmish.Glue.Core\Elmish.Glue.Core.fsproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalGlue)' != 'true'">
    <PackageReference Include="Elmish.Glue.Core" Version="$(ElmishGlueVersion)" />
  </ItemGroup>

</Project>
