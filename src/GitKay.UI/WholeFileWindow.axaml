<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GitKay.UI"
        x:Class="GitKay.UI.WholeFileWindow"
        x:DataType="local:WholeFileProjection"
        Title="{Binding WindowTitle}"
        Width="1000" Height="760" MinWidth="480" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource GitKayWindowBrush}">
    <DockPanel>
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource GitKayWindowBrush}"
                BorderBrush="{DynamicResource GitKayHairlineBrush}"
                BorderThickness="0,0,0,1"
                Padding="10,4">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ShortHash}" FontFamily="{x:Static local:FontStacks.Mono}" FontSize="12"
                               Foreground="{DynamicResource GitKayMutedTextBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Subject}" FontSize="13" Foreground="{DynamicResource GitKayTextBrush}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding LoadStatus}" FontSize="11" Foreground="{DynamicResource GitKayMutedTextBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="1" Classes="inline" Padding="8,2" Command="{Binding OpenInVsCodeCommand}" ToolTip.Tip="Open in VS Code, rooted at the repository">
                    <TextBlock Text="Open in VS Code" FontSize="11" />
                </Button>
                <Border Grid.Column="2"
                        Background="{DynamicResource GitKayRaisedBrush}"
                        BorderBrush="{DynamicResource GitKayBorderBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="1">
                    <StackPanel Orientation="Horizontal" Spacing="1">
                        <Button Classes="segment" Classes.selected="{Binding IsUnifiedMode}" Command="{Binding SetModeCommand}" CommandParameter="diff" ToolTip.Tip="Unified diff — changes inline">
                            <Canvas Width="16" Height="16">
                                <Rectangle Canvas.Left="0.5" Canvas.Top="1.5" Width="15" Height="13" RadiusX="2" RadiusY="2" Stroke="{DynamicResource GitKaySecondaryTextBrush}" StrokeThickness="1" />
                                <Rectangle Canvas.Left="3" Canvas.Top="5" Width="10" Height="2" Fill="{DynamicResource GitKayRemovedAccentBrush}" />
                                <Rectangle Canvas.Left="3" Canvas.Top="9" Width="10" Height="2" Fill="{DynamicResource GitKayAddedAccentBrush}" />
                            </Canvas>
                        </Button>
                        <Button Classes="segment" Classes.selected="{Binding IsSideBySideMode}" Command="{Binding SetModeCommand}" CommandParameter="side-by-side" ToolTip.Tip="Side-by-side — old left, new right">
                            <Canvas Width="16" Height="16">
                                <Rectangle Canvas.Left="0.5" Canvas.Top="1.5" Width="15" Height="13" RadiusX="2" RadiusY="2" Stroke="{DynamicResource GitKaySecondaryTextBrush}" StrokeThickness="1" />
                                <Rectangle Canvas.Left="7.5" Canvas.Top="2" Width="1" Height="12" Fill="{DynamicResource GitKaySecondaryTextBrush}" />
                                <Rectangle Canvas.Left="2.5" Canvas.Top="7" Width="4" Height="2" Fill="{DynamicResource GitKayRemovedAccentBrush}" />
                                <Rectangle Canvas.Left="9.5" Canvas.Top="7" Width="4" Height="2" Fill="{DynamicResource GitKayAddedAccentBrush}" />
                            </Canvas>
                        </Button>
                        <Button Classes="segment" Classes.selected="{Binding IsNewMode}" Command="{Binding SetModeCommand}" CommandParameter="new" ToolTip.Tip="New file — after the change">
                            <Canvas Width="16" Height="16">
                                <Path Data="M3,0.5 H10 L13.5,4 V15.5 H3 Z" Stroke="{DynamicResource GitKaySecondaryTextBrush}" StrokeThickness="1" />
                                <Rectangle Canvas.Left="5" Canvas.Top="7.5" Width="6" Height="2" Fill="{DynamicResource GitKayAddedAccentBrush}" />
                                <Rectangle Canvas.Left="7" Canvas.Top="5.5" Width="2" Height="6" Fill="{DynamicResource GitKayAddedAccentBrush}" />
                            </Canvas>
                        </Button>
                        <Button Classes="segment" Classes.selected="{Binding IsOldMode}" Command="{Binding SetModeCommand}" CommandParameter="old" ToolTip.Tip="Old file — before the change">
                            <Canvas Width="16" Height="16">
                                <Path Data="M3,0.5 H10 L13.5,4 V15.5 H3 Z" Stroke="{DynamicResource GitKaySecondaryTextBrush}" StrokeThickness="1" />
                                <Rectangle Canvas.Left="5" Canvas.Top="7.5" Width="6" Height="2" Fill="{DynamicResource GitKayRemovedAccentBrush}" />
                            </Canvas>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <Panel>
            <ScrollViewer x:Name="RowsScrollViewer" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <local:DiffSurfaceControl x:Name="Surface"
                                          ItemsSource="{Binding Rows}"
                                          SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                                          DiffLayout="{Binding Layout}"
                                          CodeFontSize="{Binding Main.DiffFontSize, Mode=TwoWay}"
                                          ToggleFileCommand="{Binding ToggleCollapsedCommand}"
                                          HorizontalAlignment="Stretch" />
            </ScrollViewer>
            <local:OverviewRuler Width="4" HorizontalAlignment="Left" ZIndex="5" Source="{Binding #Surface}" />
        </Panel>
    </DockPanel>
</Window>
