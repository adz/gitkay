<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GitKay.UI"
        x:Class="GitKay.UI.CommitWindow"
        x:DataType="local:CommitWindowProjection"
        Title="{Binding WindowTitle}"
        Width="1200" Height="820" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource GitKayWindowBrush}">
    <Window.Styles>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource GitKayTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.bar">
            <Setter Property="Background" Value="{DynamicResource GitKaySurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GitKayHairlineBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="10,5" />
        </Style>
        <!-- git gui's colours: unstaged changes under a salmon title, staged changes under a green one. -->
        <Style Selector="Border.unstagedTitle">
            <Setter Property="Background" Value="{DynamicResource GitKayRemovedGutterBrush}" />
        </Style>
        <Style Selector="Border.stagedTitle">
            <Setter Property="Background" Value="{DynamicResource GitKayAddedGutterBrush}" />
        </Style>
        <Style Selector="TextBlock.stagedMarker">
            <Setter Property="Foreground" Value="{DynamicResource GitKayAddedAccentBrush}" />
        </Style>
        <Style Selector="TextBlock.unstagedMarker">
            <Setter Property="Foreground" Value="{DynamicResource GitKayRemovedAccentBrush}" />
        </Style>
        <Style Selector="Button.action">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Background" Value="{DynamicResource GitKayControlBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GitKayControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Foreground" Value="{DynamicResource GitKayTextBrush}" />
        </Style>
        <Style Selector="Button.action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource GitKayControlHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GitKayControlBorderBrush}" />
        </Style>
        <Style Selector="Button.action TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GitKayTextBrush}" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
        <!-- Commit is the window's main action: filled with the accent colour. -->
        <Style Selector="Button.primary">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Background" Value="{DynamicResource GitKayPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource GitKayPrimaryBrush}" />
            <Setter Property="Opacity" Value="0.9" />
        </Style>
        <Style Selector="Button.primary TextBlock">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource GitKayControlBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GitKayControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.primary:disabled TextBlock, Button.action:disabled TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GitKayMutedTextBrush}" />
        </Style>
        <Style Selector="TextBox#MessageBox">
            <Setter Property="Background" Value="{DynamicResource GitKayControlBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GitKayControlBorderBrush}" />
        </Style>
        <Style Selector="TextBlock.warning">
            <Setter Property="Foreground" Value="{DynamicResource GitKayRemovedAccentBrush}" />
        </Style>
    </Window.Styles>

    <Panel>
        <Grid RowDefinitions="Auto,*">
            <!-- Current branch, as git gui shows it. -->
            <Border Grid.Row="0" Classes="bar" BorderBrush="{DynamicResource GitKayBorderBrush}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <TextBlock Text="Current Branch:" FontSize="12" Foreground="{DynamicResource GitKaySecondaryTextBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Branch}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource GitKayTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="F1 for keys" FontSize="11" Foreground="{DynamicResource GitKayMutedTextBrush}" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" ColumnDefinitions="320,Auto,*">
                <!-- Unstaged and staged files down the whole left side. -->
                <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto,*">
                    <Border x:Name="UnstagedPaneEffect" Grid.Row="0" Grid.RowSpan="2" />
                    <Border x:Name="StagedPaneEffect" Grid.Row="2" Grid.RowSpan="2" />
                    <Border x:Name="UnstagedTitleBar" Grid.Row="0" Classes="bar unstagedTitle">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="sectionTitle" Text="{Binding UnstagedTitle}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Border Background="{DynamicResource GitKayRaisedBrush}" BorderBrush="{DynamicResource GitKayBorderBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="1" VerticalAlignment="Center"
                                    ToolTip.Tip="How both lists show their files">
                                <StackPanel Orientation="Horizontal">
                                    <Button Classes="segment" Classes.selected="{Binding IsPatchFileListMode}"
                                            Command="{Binding SetFileListModeCommand}" CommandParameter="patch"
                                            ToolTip.Tip="Patch — changed files as full paths">
                                        <TextBlock Text="Patch" FontSize="11" />
                                    </Button>
                                    <Button Classes="segment" Classes.selected="{Binding IsTreeFileListMode}"
                                            Command="{Binding SetFileListModeCommand}" CommandParameter="tree"
                                            ToolTip.Tip="Tree — changed files grouped by folder">
                                        <TextBlock Text="Tree" FontSize="11" />
                                    </Button>
                                    <Button Classes="segment" Classes.selected="{Binding IsAllFilesMode}"
                                            Command="{Binding SetFileListModeCommand}" CommandParameter="all"
                                            ToolTip.Tip="All files — every file in the repository, as a tree">
                                        <TextBlock Text="All" FontSize="11" />
                                    </Button>
                                </StackPanel>
                            </Border>
                            <Button Classes="action" Padding="8,1" Command="{Binding StageAllCommand}"
                                    ToolTip.Tip="Stage every unstaged and untracked file (Ctrl+I)">
                                <TextBlock Text="Stage all" FontSize="11" />
                            </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ListBox Grid.Row="1" x:Name="UnstagedList" ItemsSource="{Binding UnstagedRows}"
                             SelectedItem="{Binding SelectedUnstagedRow, Mode=TwoWay}"
                             Background="Transparent" DoubleTapped="OnFileDoubleTapped" ContextRequested="OnFileContextRequested">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="x:Object">
                                <ContentControl Content="{Binding}">
                                    <ContentControl.DataTemplates>
                                        <DataTemplate x:DataType="local:CommitFileRow">
                                            <Grid ColumnDefinitions="18,*" Margin="{Binding ListIndent}" ToolTip.Tip="{Binding Path}" Background="Transparent">
                                                <TextBlock Text="{Binding Marker}" FontSize="12" Classes="unstagedMarker" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding ListLabel}" FontSize="12" Foreground="{DynamicResource GitKayTextBrush}"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                        <DataTemplate x:DataType="local:CommitFolderRow">
                                            <Grid ColumnDefinitions="*,Auto" Background="Transparent" Cursor="Hand"
                                                  PointerPressed="OnFolderPointerPressed" ToolTip.Tip="{Binding Path}">
                                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="{Binding Indent}">
                                                    <Panel Width="10" Height="10" VerticalAlignment="Center">
                                                        <PathIcon Width="8" Height="8" Data="M5,2 L11,8 L5,14 L3.6,12.6 L8.2,8 L3.6,3.4 Z"
                                                                  Foreground="{DynamicResource GitKaySecondaryTextBrush}" IsVisible="{Binding !IsExpanded}" />
                                                        <PathIcon Width="8" Height="8" Data="M2,5 L8,11 L14,5 L12.6,3.6 L8,8.2 L3.4,3.6 Z"
                                                                  Foreground="{DynamicResource GitKaySecondaryTextBrush}" IsVisible="{Binding IsExpanded}" />
                                                    </Panel>
                                                    <PathIcon Width="14" Height="12" VerticalAlignment="Center"
                                                              Data="M1,3 C1,2 1.5,1.5 2.5,1.5 H6 L7.5,3 H13.5 C14.5,3 15,3.5 15,4.5 V12.5 C15,13.5 14.5,14 13.5,14 H2.5 C1.5,14 1,13.5 1,12.5 Z"
                                                              Foreground="{DynamicResource GitKayMutedTextBrush}" />
                                                    <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource GitKaySecondaryTextBrush}"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding CountText}" FontSize="11" Margin="6,0,4,0"
                                                           Foreground="{DynamicResource GitKayMutedTextBrush}" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                        <DataTemplate x:DataType="local:CommitRepoFileRow">
                                            <Grid ColumnDefinitions="18,*" Margin="{Binding Indent}" ToolTip.Tip="{Binding Path}" Background="Transparent">
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12"
                                                           Foreground="{DynamicResource GitKayMutedTextBrush}"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ContentControl.DataTemplates>
                                </ContentControl>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <!-- Hold Ctrl: hints overlay their panes without moving anything. -->
                    <Border Classes="keyHint" IsVisible="{Binding IsCtrlHintsVisible}" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,10,0"><TextBlock Text="Ctrl+1  unstaged · Ctrl+I  stage all" /></Border>
                    <!-- The boundary between the two lists is draggable, like every other edge in the window. -->
                    <GridSplitter Grid.Row="2" Height="6" VerticalAlignment="Top" Margin="0,-3,0,0" ZIndex="5"
                                  Background="Transparent" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" />
                    <Border x:Name="StagedTitleBar" Grid.Row="2" Classes="bar stagedTitle" BorderThickness="0,1,0,1">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="sectionTitle" Text="{Binding StagedTitle}" />
                            <Button Grid.Column="1" Classes="action" Padding="8,1" Command="{Binding UnstageAllCommand}"
                                    ToolTip.Tip="Unstage every staged file">
                                <TextBlock Text="Unstage all" FontSize="11" />
                            </Button>
                        </Grid>
                    </Border>
                    <ListBox Grid.Row="3" x:Name="StagedList" ItemsSource="{Binding StagedRows}"
                             SelectedItem="{Binding SelectedStagedRow, Mode=TwoWay}"
                             Background="Transparent" DoubleTapped="OnFileDoubleTapped" ContextRequested="OnFileContextRequested">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="x:Object">
                                <ContentControl Content="{Binding}">
                                    <ContentControl.DataTemplates>
                                        <DataTemplate x:DataType="local:CommitFileRow">
                                            <Grid ColumnDefinitions="18,*" Margin="{Binding ListIndent}" ToolTip.Tip="{Binding Path}" Background="Transparent">
                                                <TextBlock Text="{Binding Marker}" FontSize="12" Classes="stagedMarker" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding ListLabel}" FontSize="12" Foreground="{DynamicResource GitKayTextBrush}"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                        <DataTemplate x:DataType="local:CommitFolderRow">
                                            <Grid ColumnDefinitions="*,Auto" Background="Transparent" Cursor="Hand"
                                                  PointerPressed="OnFolderPointerPressed" ToolTip.Tip="{Binding Path}">
                                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="{Binding Indent}">
                                                    <Panel Width="10" Height="10" VerticalAlignment="Center">
                                                        <PathIcon Width="8" Height="8" Data="M5,2 L11,8 L5,14 L3.6,12.6 L8.2,8 L3.6,3.4 Z"
                                                                  Foreground="{DynamicResource GitKaySecondaryTextBrush}" IsVisible="{Binding !IsExpanded}" />
                                                        <PathIcon Width="8" Height="8" Data="M2,5 L8,11 L14,5 L12.6,3.6 L8,8.2 L3.4,3.6 Z"
                                                                  Foreground="{DynamicResource GitKaySecondaryTextBrush}" IsVisible="{Binding IsExpanded}" />
                                                    </Panel>
                                                    <PathIcon Width="14" Height="12" VerticalAlignment="Center"
                                                              Data="M1,3 C1,2 1.5,1.5 2.5,1.5 H6 L7.5,3 H13.5 C14.5,3 15,3.5 15,4.5 V12.5 C15,13.5 14.5,14 13.5,14 H2.5 C1.5,14 1,13.5 1,12.5 Z"
                                                              Foreground="{DynamicResource GitKayMutedTextBrush}" />
                                                    <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource GitKaySecondaryTextBrush}"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding CountText}" FontSize="11" Margin="6,0,4,0"
                                                           Foreground="{DynamicResource GitKayMutedTextBrush}" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                        <DataTemplate x:DataType="local:CommitRepoFileRow">
                                            <Grid ColumnDefinitions="18,*" Margin="{Binding Indent}" ToolTip.Tip="{Binding Path}" Background="Transparent">
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12"
                                                           Foreground="{DynamicResource GitKayMutedTextBrush}"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ContentControl.DataTemplates>
                                </ContentControl>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border Classes="keyHint" IsVisible="{Binding IsCtrlHintsVisible}" Grid.Row="3" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,10,0"><TextBlock Text="Ctrl+2  staged · Ctrl+U  unstage" /></Border>
                </Grid>

                <GridSplitter x:Name="ListsSplitterLine" Grid.Column="1" Width="1" Background="{DynamicResource GitKayBorderBrush}" ResizeDirection="Columns" />

                <!-- The diff above the commit message, both beside the file lists. -->
                <Grid Grid.Column="2" RowDefinitions="3*,Auto,*">
                    <Border x:Name="DiffPaneEffect" Grid.Row="0" />
                    <Border x:Name="MessagePaneEffect" Grid.Row="2" />
                    <DockPanel x:Name="DiffPanePart" Grid.Row="0">
                        <Border DockPanel.Dock="Top" Classes="bar">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding DiffTitle}" FontSize="12" Foreground="{DynamicResource GitKayTextBrush}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasSelectedFile}">
                                    <Button Classes="action" Padding="8,1" Command="{Binding ApplyToSelectionCommand}" IsVisible="{Binding CanApplyToLines}"
                                            ToolTip.Tip="{Binding SelectionActionTip}">
                                        <TextBlock Text="{Binding SelectionActionLabel}" FontSize="11" />
                                    </Button>
                                    <Button Classes="action" Padding="8,1" Command="{Binding ToggleFileCommand}"
                                            ToolTip.Tip="Move the whole file to the other list (Enter, Ctrl+S / Ctrl+U)">
                                        <TextBlock Text="{Binding FileActionLabel}" FontSize="11" />
                                    </Button>
                                    <Button Classes="action" Padding="8,1" Command="{Binding DiscardCommand}" IsVisible="{Binding CanDiscard}"
                                            ToolTip.Tip="Throw away the selected lines, or the whole file, from the working tree (Ctrl+J)">
                                        <TextBlock Text="{Binding DiscardLabel}" FontSize="11" Foreground="{DynamicResource GitKayRemovedAccentBrush}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Panel>
                            <ScrollViewer x:Name="RowsScrollViewer" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <local:DiffSurfaceControl x:Name="Surface"
                                                          ItemsSource="{Binding Rows}"
                                                          SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                                                      ExpandGapCommand="{Binding ExpandDiffGapCommand}"
                                                          CodeFontSize="{Binding DiffFontSize, Mode=TwoWay}"
                                                          HorizontalAlignment="Stretch" />
                            </ScrollViewer>
                            <TextBlock Text="{Binding EmptyDiffText}" IsVisible="{Binding !HasSelectedFile}" FontSize="13"
                                       Foreground="{DynamicResource GitKayMutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border Classes="keyHint" IsVisible="{Binding IsCtrlHintsVisible}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,16,0"><TextBlock Text="Ctrl+3  diff · Ctrl+S  stage · Ctrl+F  find · Ctrl+P  go to file" /></Border>
                            <!-- vim's / and ? overlaid on the diff's bottom edge, so opening it never moves the diff. -->
                            <Border VerticalAlignment="Bottom" ZIndex="10" IsVisible="{Binding IsSearchOpen}" Background="{DynamicResource GitKaySurfaceBrush}"
                                    BorderBrush="{DynamicResource GitKayBorderBrush}" BorderThickness="0,1,0,0" Padding="10,4">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                    <TextBlock x:Name="SearchPrefix" Text="/" FontFamily="{x:Static local:FontStacks.Mono}" FontSize="13"
                                               Foreground="{DynamicResource GitKayAccentBrush}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" x:Name="SearchBox" FontFamily="{x:Static local:FontStacks.Mono}" FontSize="12"
                                             MinHeight="0" Padding="4,2" BorderThickness="0" Background="Transparent" />
                                    <TextBlock Grid.Column="2" x:Name="SearchInfo" FontSize="11" Foreground="{DynamicResource GitKayMutedTextBrush}"
                                               VerticalAlignment="Center" Text="Enter keep · Esc cancel · ↑↓ history · Alt+R regex · Alt+C case" />
                                </Grid>
                            </Border>
                        </Panel>
                    </DockPanel>

                    <GridSplitter x:Name="DiffSplitterLine" Grid.Row="1" Height="1" Background="{DynamicResource GitKayBorderBrush}" ResizeDirection="Rows" />

                    <!-- The failure output sits above the message, inside the same row, so the splitter above them
                         hands its space straight to the message box. -->
                    <Grid Grid.Row="2" RowDefinitions="Auto,*">
                    <Border x:Name="FailureOutputPart" Grid.Row="0" IsVisible="{Binding HasFailureOutput}" MaxHeight="160"
                            Background="{DynamicResource GitKayRemovedBrush}" BorderBrush="{DynamicResource GitKayBorderBrush}" BorderThickness="0,0,0,1" Padding="10,6">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <SelectableTextBlock Text="{Binding FailureOutput}" FontFamily="{x:Static local:FontStacks.Mono}" FontSize="11"
                                                 Foreground="{DynamicResource GitKayTextBrush}" TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>

                    <Border x:Name="MessagePanePart" Grid.Row="1" Background="{DynamicResource GitKaySurfaceBrush}" Padding="10,8">
                        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="6">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                <TextBlock Classes="sectionTitle" Text="{Binding MessageTitle}" />
                                <TextBlock Grid.Column="1" Text="{Binding SubjectLengthText}" Classes.warning="{Binding IsSubjectLong}" FontSize="11"
                                           Foreground="{DynamicResource GitKayMutedTextBrush}" VerticalAlignment="Center"
                                           ToolTip.Tip="Subject length: aim for 50 characters, at most 72" />
                                <CheckBox Grid.Column="2" IsChecked="{Binding Amend, Mode=TwoWay}" Content="Amend last commit" FontSize="12"
                                          ToolTip.Tip="Replace the last commit (Ctrl+Shift+A)" />
                            </Grid>
                            <Border Classes="keyHint" IsVisible="{Binding IsCtrlHintsVisible}" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,10,0"><TextBlock Text="Ctrl+4  message · Ctrl+Enter  commit · Ctrl+S  sign off" /></Border>
                            <TextBox Grid.Row="1" x:Name="MessageBox" Text="{Binding Message, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="90" VerticalContentAlignment="Top" FontFamily="{x:Static local:FontStacks.Mono}" FontSize="12"
                                     PlaceholderText="Subject line, then a blank line and why the change was made" />
                            <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="8">
                                <Button Classes="action" Padding="10,3" Command="{Binding RescanCommand}" ToolTip.Tip="Read the working tree and index again (F5)">
                                    <TextBlock Text="Rescan" FontSize="12" />
                                </Button>
                                <Button Grid.Column="1" Classes="action" Padding="10,3" Command="{Binding UndoDiscardCommand}"
                                        IsVisible="{Binding CanUndoDiscard}" ToolTip.Tip="Put back what the last discard threw away (Ctrl+Z)">
                                    <TextBlock Text="Undo discard" FontSize="12" />
                                </Button>
                                <CheckBox Grid.Column="2" IsChecked="{Binding SignOff, Mode=TwoWay}" Content="Sign off" FontSize="12"
                                          ToolTip.Tip="Add a Signed-off-by trailer with your configured name and email (Ctrl+S in the message, Ctrl+Shift+S anywhere)" />
                                <TextBlock Grid.Column="3" Text="{Binding Status}" FontSize="12" Foreground="{DynamicResource GitKaySecondaryTextBrush}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="4" Classes="primary" Padding="14,4" Command="{Binding CommitCommand}" IsEnabled="{Binding CanCommit}"
                                        ToolTip.Tip="{Binding CommitTip}">
                                    <TextBlock Text="{Binding CommitLabel}" FontSize="12" FontWeight="SemiBold" />
                                </Button>
                                <Button Grid.Column="5" Classes="action" Padding="14,4" Command="{Binding CommitAndPushCommand}" IsEnabled="{Binding CanCommit}"
                                        ToolTip.Tip="Commit, then push the current branch">
                                    <TextBlock Text="Commit and push" FontSize="12" />
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- Ctrl+P: any changed file, staged or not. -->
        <Border IsVisible="{Binding IsFilePaletteOpen}" Background="#33000000" ZIndex="41" PointerPressed="OnPaletteBackdropPressed">
            <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,70,0,0" Width="620" MaxHeight="480" CornerRadius="8" Padding="6"
                    Background="{DynamicResource GitKaySurfaceBrush}" BorderBrush="{DynamicResource GitKayBorderBrush}" BorderThickness="1"
                    BoxShadow="0 12 32 0 #50000000">
                <DockPanel>
                    <TextBox DockPanel.Dock="Top" x:Name="PaletteBox" Text="{Binding PaletteQuery, Mode=TwoWay}" PlaceholderText="Go to changed file"
                             FontSize="13" Margin="0,0,0,6" />
                    <ListBox x:Name="PaletteList" ItemsSource="{Binding PaletteFiles}" SelectedIndex="{Binding PaletteIndex, Mode=TwoWay}"
                             Background="Transparent" DoubleTapped="OnPaletteDoubleTapped">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="local:CommitFileRow">
                                <Grid ColumnDefinitions="18,*,Auto" ColumnSpacing="6">
                                    <TextBlock Text="{Binding Marker}" FontSize="12" Classes.stagedMarker="{Binding IsStaged}" Classes.unstagedMarker="{Binding !IsStaged}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource GitKayTextBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding ListName}" FontSize="11" Foreground="{DynamicResource GitKayMutedTextBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Border>

        <!-- Keys, opened with F1. -->
        <Border IsVisible="{Binding IsKeysOpen}" Background="#33000000" ZIndex="40" PointerPressed="OnKeysBackdropPressed">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="880" MaxHeight="720" CornerRadius="8" Padding="18,14"
                    Background="{DynamicResource GitKaySurfaceBrush}" BorderBrush="{DynamicResource GitKayBorderBrush}" BorderThickness="1"
                    BoxShadow="0 12 32 0 #50000000">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                        <TextBlock Text="Commit window keys" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource GitKayTextBrush}" />
                        <TextBlock Grid.Column="1" Text="F1 or Esc to close" FontSize="11" Foreground="{DynamicResource GitKayMutedTextBrush}" VerticalAlignment="Center" />
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding KeyGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:CommitKeyGroup">
                                    <StackPanel Margin="0,0,0,12" Spacing="3">
                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource GitKayAccentBrush}" />
                                        <ItemsControl ItemsSource="{Binding Keys}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="local:CommitKey">
                                                    <Grid ColumnDefinitions="290,*" ColumnSpacing="12" Margin="0,1">
                                                        <TextBlock Text="{Binding Keys}" FontFamily="{x:Static local:FontStacks.Mono}" FontSize="12" LineHeight="18"
                                                                   TextWrapping="Wrap" VerticalAlignment="Top" Foreground="{DynamicResource GitKayTextBrush}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Description}" FontSize="12" LineHeight="18"
                                                                   TextWrapping="Wrap" VerticalAlignment="Top" Foreground="{DynamicResource GitKaySecondaryTextBrush}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Border>
    </Panel>
</Window>
