<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GitKay.UI"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="GitKay.UI.MainWindow"
        x:Name="RootWindow"
        x:DataType="local:MainProjection"
        Title="GitKay"
        Background="{DynamicResource GitKayWindowBrush}">

    <DockPanel>

        <Border x:Name="StatusBar" DockPanel.Dock="Bottom" Classes="statusBar" Classes.error="{Binding IsStatusError}"
                BorderBrush="{DynamicResource GitKayHairlineBrush}" BorderThickness="0,1,0,0" Padding="8,3" IsVisible="{Binding IsStatusVisible}">
            <Border.Styles>
                <Style Selector="Border.statusBar">
                    <Setter Property="Background" Value="{DynamicResource GitKayWindowBrush}" />
                </Style>
                <Style Selector="Border.statusBar > Panel > TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource GitKaySecondaryTextBrush}" />
                </Style>
                <!-- Errors are easy to miss in a quiet footer: tint it and pulse when a new one arrives. -->
                <Style Selector="Border.statusBar.error">
                    <Setter Property="Background" Value="{DynamicResource GitKayRemovedAccentBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource GitKayRemovedAccentBrush}" />
                </Style>
                <Style Selector="Border.statusBar.error > Panel > TextBlock">
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Style>
                <Style Selector="Border.statusBar.pulse">
                    <Style.Animations>
                        <Animation Duration="0:0:0.45" IterationCount="6" PlaybackDirection="Alternate" Easing="SineEaseInOut">
                            <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                            <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.25" /></KeyFrame>
                        </Animation>
                    </Style.Animations>
                </Style>
            </Border.Styles>
            <Panel>
                <TextBlock Text="{Binding Status}" FontSize="11" IsVisible="{Binding !IsSearchPromptOpen}" />
                <!-- vim's / and ? prompt: incremental search; Enter keeps it for n / N, Esc cancels. -->
                <Grid x:Name="SearchPrompt" ColumnDefinitions="Auto,*,Auto,Auto" IsVisible="{Binding IsSearchPromptOpen}">
                    <TextBlock x:Name="SearchPromptPrefix" Grid.Column="0" Text="/" FontFamily="{x:Static local:FontStacks.Mono}" FontSize="12"
                               Foreground="{DynamicResource GitKayAccentBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBox x:Name="SearchPromptBox" Grid.Column="1" MinWidth="160" FontFamily="{x:Static local:FontStacks.Mono}" FontSize="12"
                             MinHeight="0" Padding="0" BorderThickness="0" Background="Transparent" VerticalAlignment="Center">
                        <TextBox.Styles>
                            <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                            </Style>
                            <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                            </Style>
                        </TextBox.Styles>
                    </TextBox>
                    <TextBlock x:Name="SearchPromptInfo" Grid.Column="2" FontSize="11" Foreground="{DynamicResource GitKaySecondaryTextBrush}"
                               VerticalAlignment="Center" Margin="8,0,0,0" />
                    <!-- The prompt's keys, so they needn't be remembered; trimmed before the input when the window is narrow. -->
                    <TextBlock x:Name="SearchPromptKeys" Grid.Column="3" FontSize="11" Foreground="{DynamicResource GitKayMutedTextBrush}"
                               VerticalAlignment="Center" Margin="16,0,0,0" TextTrimming="CharacterEllipsis"
                               Text="Esc cancel · ↑↓ history · Alt+R regex · Alt+C case · /i ignore case · \V literal · \&lt; \&gt; word" />
                </Grid>
            </Panel>
        </Border>

        <Grid>
        <Grid x:Name="MainSplitGrid"
              RowDefinitions="3*,6,7*"
              MinHeight="0">
            <Border x:Name="CommitPaneEffect" Grid.Row="0" />
            <Border x:Name="CommitPaneContent" Grid.Row="0"
                    Background="{DynamicResource GitKayWindowBrush}">
                <Grid MinHeight="0"
                      RowDefinitions="Auto,24,*"
                      Grid.IsSharedSizeScope="True">
                    <!-- Commit search above the history; the hamburger holds the app menu. -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource GitKayChromeBrush}"
                            BorderBrush="{DynamicResource GitKayHairlineBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="6,4">
                        <Grid RowDefinitions="Auto,Auto,Auto">
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
<Border Classes="keyHint" IsVisible="{Binding IsCtrlHintsVisible}" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="Ctrl+⇧P" /></Border>
                            <Button x:Name="AppMenuButton"
                                    Width="28" Height="28" Padding="0"
                                    Background="Transparent" BorderThickness="0"
                                    ToolTip.Tip="Menu">
                                <PathIcon Width="14" Height="14"
                                          Data="M1,3h14v1.6H1z M1,7.2h14v1.6H1z M1,11.4h14v1.6H1z"
                                          Foreground="{DynamicResource GitKaySecondaryTextBrush}" />
                                <Button.Flyout>
                                    <!-- Ordered by how often it's reached for: refreshing, then help, then what's shown, then the repository. -->
                                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                        <MenuItem Header="_Reread refs" Command="{Binding RereadRefs}" InputGesture="F5" />
                                        <MenuItem Header="_Fetch all remotes" Click="OnFetchAllMenuItemClick" />
                                        <Separator />
                                        <MenuItem Header="_Keyboard shortcuts" Command="{Binding ToggleShortcutHelpCommand}" InputGesture="F1" />
                                        <MenuItem Header="_Settings…" Click="OnSettingsMenuItemClick" />
                                        <Separator />
                                        <MenuItem Header="Show _branch refs" ToggleType="CheckBox" IsChecked="{Binding ShowBranchRefs, Mode=TwoWay}" />
                                        <MenuItem Header="Show _stashes" ToggleType="CheckBox" IsChecked="{Binding ShowStashes, Mode=TwoWay}" />
                                        <MenuItem Header="_All branches (--all)" ToggleType="CheckBox" IsChecked="{Binding IsAllBranches, Mode=TwoWay}" />
                                        <Separator />
                                        <MenuItem Header="_Open">
                                            <MenuItem Header="Git _repository…" Click="OnOpenRepositoryMenuItemClick"
                                                      ToolTip.Tip="Open another local Git repository, with its history" />
                                            <MenuItem Header="_Folder…" Click="OnOpenFolderMenuItemClick"
                                                      ToolTip.Tip="Browse a folder: its files, previews and syntax highlighting" />
                                            <MenuItem Header="_Compare two folders…" Click="OnCompareFoldersMenuItemClick"
                                                      ToolTip.Tip="Compare two folders, with no repository involved" />
                                        </MenuItem>
                                        <MenuItem Header="_Commit…" Click="OnCommitWindowMenuItemClick" InputGesture="Ctrl+Shift+C"
                                                  IsEnabled="{Binding HasUncommittedChanges}" />
                                        <Separator />
                                        <MenuItem Header="_About GitKay…" Click="OnAboutMenuItemClick" />
                                        <MenuItem Header="E_xit" Click="OnExitMenuItemClick" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>


<Border Classes="keyHint" IsVisible="{Binding IsCtrlHintsVisible}" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0"><TextBlock Text="Ctrl+F  find" /></Border>
                            <Panel Grid.Column="2" MinWidth="220">
                                <TextBox x:Name="SearchBox"
                                         Height="28"
                                         Text="{Binding SearchQuery, Mode=TwoWay}"
                                         PlaceholderText="{Binding SearchPlaceholder}"
                                         GotFocus="OnSearchBoxGotFocus"
                                         LostFocus="OnSearchBoxLostFocus"
                                         TextChanged="OnSearchBoxTextChanged"
                                         KeyDown="OnSearchBoxKeyDown">
                                    <TextBox.InnerRightContent>
                                        <StackPanel Orientation="Horizontal" Spacing="2" Margin="0,0,4,0">
<StackPanel Orientation="Horizontal" Spacing="2" IsVisible="{Binding HasSearchNavigation}">
                                            <TextBlock Text="{Binding CommitSearchStatusText}"
                                                       Foreground="{DynamicResource GitKayMutedTextBrush}"
                                                       FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />
                                            <Button Classes="inline" Command="{Binding FindPreviousCommitCommand}" ToolTip.Tip="Previous match (Shift+Enter, N)">
                                                <PathIcon Width="9" Height="9" Data="M2,11 L8,5 L14,11 L12.6,12.4 L8,7.8 L3.4,12.4 Z" Foreground="{DynamicResource GitKaySecondaryTextBrush}" />
                                            </Button>
                                            <Button Classes="inline" Command="{Binding FindNextCommitCommand}" ToolTip.Tip="Next match (Enter, n)">
                                                <PathIcon Width="9" Height="9" Data="M2,5 L8,11 L14,5 L12.6,3.6 L8,8.2 L3.4,3.6 Z" Foreground="{DynamicResource GitKaySecondaryTextBrush}" />
                                            </Button>
                                        </StackPanel>
<ToggleButton Classes="inline" IsChecked="{Binding SearchUseRegex}" ToolTip.Tip="Regular expression">
    <TextBlock Text=".*" FontSize="11" FontFamily="{x:Static local:FontStacks.Mono}" />
</ToggleButton>
<ToggleButton Classes="inline" IsChecked="{Binding ShowOnlySearchMatches}" ToolTip.Tip="Show only matching commits">
    <PathIcon Width="10" Height="10" Data="M1,2 H15 L9.5,8.5 V14 L6.5,12.5 V8.5 Z" Foreground="{DynamicResource GitKaySecondaryTextBrush}" />
</ToggleButton>
</StackPanel>
                                    </TextBox.InnerRightContent>
                                </TextBox>
                                <Popup IsOpen="{Binding IsRecentSearchesOpen}"
                                       PlacementTarget="{Binding #SearchBox}"
                                       Placement="BottomEdgeAlignedLeft"
                                       IsLightDismissEnabled="False">
                                    <Border Background="{DynamicResource GitKaySurfaceBrush}"
                                            BorderBrush="{DynamicResource GitKayBorderBrush}"
                                            BorderThickness="1" CornerRadius="4" Padding="2"
                                            Width="380" HorizontalAlignment="Left"
                                            BoxShadow="0 4 12 0 #40000000">
                                        <StackPanel>
                                            <TextBlock Text="Recent searches  ·  ↓ to show while typing" FontSize="10" Margin="8,4"
                                                       Foreground="{DynamicResource GitKayMutedTextBrush}" />
                                            <ListBox x:Name="RecentSearchesList"
                                                     ItemsSource="{Binding RecentSearchMatches}"
                                                     Background="Transparent" BorderThickness="0"
                                                     PointerReleased="OnRecentSearchPointerReleased">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <TextBlock Text="{Binding}" FontSize="11" Margin="4,0" Foreground="{DynamicResource GitKaySecondaryTextBrush}" />
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Panel>

                            <Border Grid.Column="3" Classes="segmentGroup" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="1">
                                    <Button Classes="segment text" Classes.selected="{Binding IsCommitSearchMode}"
                                            Command="{Binding SetSearchModeCommand}" CommandParameter="commit"
                                            ToolTip.Tip="Commit — headline, message, hash and branch names (instant)">
                                        <TextBlock Text="Commit" FontSize="11" />
                                    </Button>
                                    <Button Classes="segment text" Classes.selected="{Binding IsPathSearchMode}"
                                            Command="{Binding SetSearchModeCommand}" CommandParameter="path"
                                            ToolTip.Tip="Path — files the commit changed">
                                        <TextBlock Text="Path" FontSize="11" />
                                    </Button>
                                    <Button Classes="segment text" Classes.selected="{Binding IsDiffSearchMode}"
                                            Command="{Binding SetSearchModeCommand}" CommandParameter="diff"
                                            ToolTip.Tip="Diff — lines the commit added or removed">
                                        <TextBlock Text="Diff" FontSize="11" />
                                    </Button>
                                </StackPanel>
                            </Border>
<StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
<!-- History is limited to what a branch or tag reaches: its name, with ✕ to go back. -->
<Border x:Name="BranchFilterChip" IsVisible="{Binding HasHistoryTipFilter}" VerticalAlignment="Center"
        Background="{DynamicResource GitKayAccentBrush}" CornerRadius="9" Padding="7,1,2,1" Cursor="Hand"
        ToolTip.Tip="{Binding HistoryTipFilterTip}"
        ContextRequested="OnBranchFilterChipContextRequested"
        PointerReleased="OnBranchFilterChipPointerReleased">
    <StackPanel Orientation="Horizontal" Spacing="3">
        <TextBlock Text="{Binding HistoryTipFilter}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="White" MaxWidth="180" TextTrimming="CharacterEllipsis" />
        <Button Classes="inline" Width="16" Height="16" Padding="0" Command="{Binding ClearHistoryTipFilterCommand}"
                ToolTip.Tip="Back to the full history">
            <Path Width="8" Height="8" Stretch="Uniform" Data="M0,0 L10,10 M10,0 L0,10" Stroke="White" StrokeThickness="1.6" StrokeLineCap="Round" />
        </Button>
    </StackPanel>
</Border>
<!-- History is limited to a file: a compact marker; hover names the file, right-click or ✕ acts on it. -->
<Border x:Name="FileFilterChip" IsVisible="{Binding HasHistoryPathFilter}" VerticalAlignment="Center"
        Background="{DynamicResource GitKayAccentBrush}" CornerRadius="9" Padding="7,1,2,1" Cursor="Hand"
        ToolTip.Tip="{Binding HistoryPathFilterTip}"
        ContextRequested="OnFileFilterChipContextRequested"
        PointerReleased="OnFileFilterChipPointerReleased">
    <StackPanel Orientation="Horizontal" Spacing="3">
        <TextBlock Text="FILE FILTERED" FontSize="10" FontWeight="SemiBold" LetterSpacing="0.4" VerticalAlignment="Center" Foreground="White" />
        <Button Classes="inline" Width="16" Height="16" Padding="0" Command="{Binding ClearHistoryPathFilterCommand}"
                ToolTip.Tip="Clear the file filter and show the full history">
            <Path Width="8" Height="8" Stretch="Uniform" Data="M0,0 L10,10 M10,0 L0,10" Stroke="White" StrokeThickness="1.6" StrokeLineCap="Round" />
        </Button>
    </StackPanel>
</Border>
</StackPanel>
<ToggleButton Grid.Column="4" Classes="expander" IsChecked="{Binding IsAdvancedSearchExpanded}" ToolTip.Tip="Advanced search — one field per input">
    <Panel Width="10" Height="10" VerticalAlignment="Center">
        <PathIcon Width="10" Height="10" Data="M2,5 L8,11 L14,5 L12.6,3.6 L8,8.2 L3.4,3.6 Z" IsVisible="{Binding !IsAdvancedSearchExpanded}" Foreground="{DynamicResource GitKaySecondaryTextBrush}" />
        <PathIcon Width="10" Height="10" Data="M2,11 L8,5 L14,11 L12.6,12.4 L8,7.8 L3.4,12.4 Z" IsVisible="{Binding IsAdvancedSearchExpanded}" Foreground="{DynamicResource GitKaySecondaryTextBrush}" />
    </Panel>
</ToggleButton>
                        </Grid>

                        <!-- Ignored parts of the search (a date that doesn't parse) are called out rather than dropped silently. -->
                        <TextBlock Grid.Row="1" Margin="40,4,6,0" FontSize="11" TextWrapping="Wrap"
                                   IsVisible="{Binding HasSearchValidationMessage}"
                                   Text="{Binding SearchValidationMessage}"
                                   Foreground="{DynamicResource GitKayRemovedAccentBrush}" VerticalAlignment="Top" />
                        <!-- Advanced search: edits the same query as prefixed terms. -->
                        <Grid Grid.Row="2" Classes="fadeIn" IsVisible="{Binding IsAdvancedSearchExpanded}"
                              Margin="40,8,6,4"
                              ColumnDefinitions="Auto,*,Auto,*,Auto,*,Auto"
                              RowDefinitions="Auto,Auto,Auto"
                              ColumnSpacing="8" RowSpacing="6">
                            <Grid.Styles>
                                <Style Selector="TextBlock.label">
                                    <Setter Property="Foreground" Value="{DynamicResource GitKaySecondaryTextBrush}" />
                                    <Setter Property="FontSize" Value="11" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                </Style>
                                <Style Selector="TextBox.field.invalid">
                                    <Setter Property="BorderBrush" Value="{DynamicResource GitKayRemovedAccentBrush}" />
                                    <Setter Property="ToolTip.Tip" Value="Not a date — try 2024-05-01, 2 weeks ago or yesterday" />
                                </Style>
                                <Style Selector="TextBox.field.invalid:focus /template/ Border#PART_BorderElement">
                                    <Setter Property="BorderBrush" Value="{DynamicResource GitKayRemovedAccentBrush}" />
                                </Style>
                                <Style Selector="AutoCompleteBox.field">
                                    <Setter Property="Height" Value="30" />
                                    <Setter Property="MinHeight" Value="30" />
                                    <Setter Property="FontSize" Value="12" />
                                </Style>
                                <Style Selector="TextBox.field">
                                    <!-- Room for the text's descenders: at 26px the placeholder's lower quarter was clipped. -->
                                    <Setter Property="Height" Value="30" />
                                    <Setter Property="MinHeight" Value="30" />
                                    <Setter Property="FontSize" Value="12" />
                                    <Setter Property="Padding" Value="8,0" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                            </Grid.Styles>
                            <TextBlock Classes="label" Text="Message" />
                            <TextBox Classes="field" Grid.Column="1" Text="{Binding AdvancedMessage, Mode=TwoWay}" PlaceholderText="headline or body" />
                            <TextBlock Classes="label" Grid.Column="2" Text="Author" />
                            <AutoCompleteBox Classes="field" Grid.Column="3" Text="{Binding AdvancedAuthor, Mode=TwoWay}" PlaceholderText="name or email"
                                             ItemsSource="{Binding AuthorSuggestions}" FilterMode="Contains" MinimumPrefixLength="1" />
                            <TextBlock Classes="label" Grid.Column="4" Text="Hash" />
                            <AutoCompleteBox Classes="field" Grid.Column="5" Text="{Binding AdvancedHash, Mode=TwoWay}" PlaceholderText="full or partial"
                                             ItemsSource="{Binding HashSuggestions}" FilterMode="StartsWith" MinimumPrefixLength="1" />

                            <TextBlock Classes="label" Grid.Row="1" Text="Branch / tag" />
                            <AutoCompleteBox Classes="field" Grid.Row="1" Grid.Column="1" Text="{Binding AdvancedRef, Mode=TwoWay}" PlaceholderText="e.g. main, v1.0"
                                             ItemsSource="{Binding RefSuggestions}" FilterMode="Contains" MinimumPrefixLength="0" />
                            <TextBlock Classes="label" Grid.Row="1" Grid.Column="2" Text="Path" />
                            <AutoCompleteBox Classes="field" Grid.Row="1" Grid.Column="3" Text="{Binding AdvancedPath, Mode=TwoWay}" PlaceholderText="file or folder"
                                             ItemsSource="{Binding PathSuggestions}" FilterMode="Contains" MinimumPrefixLength="1" />
                            <TextBlock Classes="label" Grid.Row="1" Grid.Column="4" Text="Diff" />
                            <TextBox Classes="field" Grid.Row="1" Grid.Column="5" Text="{Binding AdvancedDiff, Mode=TwoWay}" PlaceholderText="added or removed text" />

                            <TextBlock Classes="label" Grid.Row="2" Text="After" />
                            <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,Auto">
                                <TextBox Classes="field" Classes.invalid="{Binding IsAfterDateInvalid}" Text="{Binding AdvancedAfter, Mode=TwoWay}" PlaceholderText="2026, 2026-09, 2026-09-16T07:13" />
                                <Button Grid.Column="1" Classes="field" Height="30" Padding="6,0" Margin="4,0,0,0" Tag="after"
                                        Click="OnPickDateClick" ToolTip.Tip="Pick a date and time">
                                    <Path Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.2" StrokeLineCap="Round"
                                          Data="M2.5,3.5 H13.5 V13.5 H2.5 Z M2.5,6.5 H13.5 M5.5,1.8 V4 M10.5,1.8 V4"
                                          Stroke="{DynamicResource GitKaySecondaryTextBrush}" />
                                </Button>
                            </Grid>
                            <TextBlock Classes="label" Grid.Row="2" Grid.Column="2" Text="Before" />
                            <Grid Grid.Row="2" Grid.Column="3" ColumnDefinitions="*,Auto">
                                <TextBox Classes="field" Classes.invalid="{Binding IsBeforeDateInvalid}" Text="{Binding AdvancedBefore, Mode=TwoWay}" PlaceholderText="2026, 2026-09, 2026-09-16T07:13" />
                                <Button Grid.Column="1" Classes="field" Height="30" Padding="6,0" Margin="4,0,0,0" Tag="before"
                                        Click="OnPickDateClick" ToolTip.Tip="Pick a date and time">
                                    <Path Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.2" StrokeLineCap="Round"
                                          Data="M2.5,3.5 H13.5 V13.5 H2.5 Z M2.5,6.5 H13.5 M5.5,1.8 V4 M10.5,1.8 V4"
                                          Stroke="{DynamicResource GitKaySecondaryTextBrush}" />
                                </Button>
                            </Grid>
                            <Button Grid.Row="2" Grid.Column="5" HorizontalAlignment="Right" Height="30" Padding="10,0"
                                    Content="Clear" Command="{Binding ClearAdvancedSearchCommand}" />
                        </Grid>
                        </Grid>
                    </Border>


                    <Border Grid.Row="1"
                            Background="{DynamicResource GitKayChromeBrush}"
                            BorderBrush="{DynamicResource GitKayHairlineBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid x:Name="HistoryHeaderGrid"
                              Width="{Binding #CommitListBox.Bounds.Width}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" MinWidth="36" />
                                <ColumnDefinition Width="*" MinWidth="120" />
                                <ColumnDefinition Width="54" MinWidth="48" />
                                <ColumnDefinition Width="240" MinWidth="72" />
                                <ColumnDefinition Width="110" MinWidth="90" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="6,0" VerticalAlignment="Center" Background="Transparent" Tag="message" ContextRequested="OnHistoryHeaderContextRequested">
                                <TextBlock Text="SUBJECT" Foreground="{DynamicResource GitKayMutedTextBrush}" FontSize="10" LetterSpacing="0.6" VerticalAlignment="Center"
                                           ToolTip.Tip="The commit message's first line" />
                                <Button Classes="funnel" IsVisible="{Binding HasCommitFilter}" Command="{Binding ClearColumnFilterCommand}" CommandParameter="message" ToolTip.Tip="Commit filter active — click to clear">
                                    <PathIcon Width="9" Height="9" Data="M1,2 H15 L9.5,8.5 V14 L6.5,12.5 V8.5 Z" Foreground="{DynamicResource GitKayAccentBrush}" />
                                </Button>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" Margin="6,0" VerticalAlignment="Center" Background="Transparent" Tag="hash" ContextRequested="OnHistoryHeaderContextRequested">
                                <TextBlock Text="HASH" Foreground="{DynamicResource GitKayMutedTextBrush}" FontSize="10" LetterSpacing="0.6" VerticalAlignment="Center" />
                                <Button Classes="funnel" IsVisible="{Binding HasHashFilter}" Command="{Binding ClearColumnFilterCommand}" CommandParameter="hash" ToolTip.Tip="Hash filter active — click to clear">
                                    <PathIcon Width="9" Height="9" Data="M1,2 H15 L9.5,8.5 V14 L6.5,12.5 V8.5 Z" Foreground="{DynamicResource GitKayAccentBrush}" />
                                </Button>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" Margin="6,0" VerticalAlignment="Center" Background="Transparent" Tag="author" ContextRequested="OnHistoryHeaderContextRequested">
                                <TextBlock Text="AUTHOR" Foreground="{DynamicResource GitKayMutedTextBrush}" FontSize="10" LetterSpacing="0.6" VerticalAlignment="Center" />
                                <Button Classes="funnel" IsVisible="{Binding HasAuthorFilter}" Command="{Binding ClearColumnFilterCommand}" CommandParameter="author" ToolTip.Tip="Author filter active — click to clear">
                                    <PathIcon Width="9" Height="9" Data="M1,2 H15 L9.5,8.5 V14 L6.5,12.5 V8.5 Z" Foreground="{DynamicResource GitKayAccentBrush}" />
                                </Button>
                            </StackPanel>
                            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" Margin="6,0" VerticalAlignment="Center" Background="Transparent" Tag="date" ContextRequested="OnHistoryHeaderContextRequested">
                                <TextBlock Text="DATE" Foreground="{DynamicResource GitKayMutedTextBrush}" FontSize="10" LetterSpacing="0.6" VerticalAlignment="Center" />
                                <Button Classes="funnel" IsVisible="{Binding HasDateFilter}" Command="{Binding ClearColumnFilterCommand}" CommandParameter="date" ToolTip.Tip="Date filter active — click to clear">
                                    <PathIcon Width="9" Height="9" Data="M1,2 H15 L9.5,8.5 V14 L6.5,12.5 V8.5 Z" Foreground="{DynamicResource GitKayAccentBrush}" />
                                </Button>
                            </StackPanel>
                            <Border Grid.Column="0" Width="4" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                                    Background="Transparent" Cursor="SizeWestEast" Tag="0"
                                    PointerPressed="OnHistoryColumnResizePointerPressed" PointerMoved="OnHistoryColumnResizePointerMoved"
                                    PointerReleased="OnHistoryColumnResizePointerReleased" PointerCaptureLost="OnHistoryColumnResizePointerCaptureLost" />
                            <Border Grid.Column="1" Width="4" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                                    Background="Transparent" Cursor="SizeWestEast" Tag="1"
                                    PointerPressed="OnHistoryColumnResizePointerPressed" PointerMoved="OnHistoryColumnResizePointerMoved"
                                    PointerReleased="OnHistoryColumnResizePointerReleased" PointerCaptureLost="OnHistoryColumnResizePointerCaptureLost" />
                            <Border Grid.Column="2"
                                    Width="4"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Stretch"
                                    Background="Transparent"
                                    Cursor="SizeWestEast"
                                    Tag="2"
                                    PointerPressed="OnHistoryColumnResizePointerPressed"
                                    PointerMoved="OnHistoryColumnResizePointerMoved"
                                    PointerReleased="OnHistoryColumnResizePointerReleased"
                                    PointerCaptureLost="OnHistoryColumnResizePointerCaptureLost" />
                            <Border Grid.Column="3"
                                    Width="4"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Stretch"
                                    Background="Transparent"
                                    Cursor="SizeWestEast"
                                    Tag="3"
                                    PointerPressed="OnHistoryColumnResizePointerPressed"
                                    PointerMoved="OnHistoryColumnResizePointerMoved"
                                    PointerReleased="OnHistoryColumnResizePointerReleased"
                                    PointerCaptureLost="OnHistoryColumnResizePointerCaptureLost" />
                        </Grid>
                    </Border>

<Border Classes="keyHint" IsVisible="{Binding IsCtrlHintsVisible}" Grid.Row="2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,4,0,0"><TextBlock Text="Ctrl+1  commits" /></Border>
                    <Border x:Name="CommitPaneFocus" Grid.Row="2" IsHitTestVisible="False" Background="{DynamicResource GitKayWindowBrush}" Opacity="0" ZIndex="10">
                        <Border.Transitions><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.12" /></Transitions></Border.Transitions>
                    </Border>
                    <ScrollViewer x:Name="CommitScrollViewer" Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <local:CommitSurfaceControl x:Name="CommitListBox" ItemsSource="{Binding Commits}" SelectedItem="{Binding SelectedCommit, Mode=TwoWay}" ShowOnlyMatches="{Binding ShowOnlySearchMatches}" SearchActive="{Binding IsCommitSearchActive}" SearchHighlight="{Binding CommitSearchHighlight}"
                            GraphWidth="{Binding #HistoryHeaderGrid.ColumnDefinitions[0].ActualWidth}" SubjectWidth="{Binding #HistoryHeaderGrid.ColumnDefinitions[1].ActualWidth}"
                            HashWidth="{Binding #HistoryHeaderGrid.ColumnDefinitions[2].ActualWidth}" AuthorWidth="{Binding #HistoryHeaderGrid.ColumnDefinitions[3].ActualWidth}"
                            DateWidth="{Binding #HistoryHeaderGrid.ColumnDefinitions[4].ActualWidth}" HorizontalAlignment="Stretch" />
                    </ScrollViewer>
                    <local:OverviewRuler Grid.Row="2" Width="4" HorizontalAlignment="Left" ZIndex="5"
                                         Source="{Binding #CommitListBox}" ToolTip.Tip="Search matches — click to jump" />
                </Grid>
            </Border>

            <Border x:Name="HistorySplitterLine" Grid.Row="1" Height="1" VerticalAlignment="Center" Background="{DynamicResource GitKayHairlineBrush}" IsHitTestVisible="False" />
            <GridSplitter Grid.Row="1"
                          Height="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Rows"
                          ResizeBehavior="PreviousAndNext" />

            <Grid Grid.Row="2"
                  RowDefinitions="Auto,*"
                  MinHeight="0">
                <Grid x:Name="DiffSplitGrid"
                      Grid.Row="0" Grid.RowSpan="2"
                      RowDefinitions="Auto,*"
                      Background="{DynamicResource GitKayWindowBrush}">
                    <!-- Minimum widths live on the columns: a content MinWidth let the splitter push the files column past the window edge. -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="240" />
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="220" MinWidth="160" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="DiffPaneEffect" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" />
                    <Border x:Name="FilesPaneEffect" Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" />
                <!-- Diff header: sits over the diff column only, so its controls end at the diff's right edge. -->
                <Border x:Name="DiffHeaderPart" Grid.Row="0" Grid.Column="0" MinHeight="37"
                        Background="{DynamicResource GitKayChromeBrush}"
                        BorderBrush="{DynamicResource GitKayHairlineBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="6,4">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto"
                          ColumnSpacing="6">
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button
                                Width="28" Height="28" Padding="0"
                                Background="Transparent" BorderThickness="0"
                                Command="{Binding ToggleCommitDetailsCommand}"
                                IsEnabled="{Binding SelectedCommit, Converter={x:Static local:ObjectConverters.IsNotNull}}"
                                ToolTip.Tip="Show commit details">
                            <Panel>
                                <PathIcon Width="12" Height="12"
                                          Data="M5,2 L11,8 L5,14 L3.6,12.6 L8.2,8 L3.6,3.4 Z"
                                          Foreground="{DynamicResource GitKaySecondaryTextBrush}"
                                          IsVisible="{Binding !IsCommitDetailsExpanded}" />
                                <PathIcon Width="12" Height="12"
                                          Data="M2,5 L8,11 L14,5 L12.6,3.6 L8,8.2 L3.4,3.6 Z"
                                          Foreground="{DynamicResource GitKaySecondaryTextBrush}"
                                          IsVisible="{Binding IsCommitDetailsExpanded}" />
                            </Panel>
                        </Button>
                        </StackPanel>

                        <!-- The hash and subject open the details too, not just the chevron; resting on them shows
                             the whole message, placed below the bar so it never covers what it describes. -->
                        <Grid Grid.Column="1"
                              IsVisible="{Binding !IsRevisionComparison}"
                              ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="8"
                              VerticalAlignment="Center"
                              Background="Transparent"
                              Cursor="Hand"
                              PointerPressed="OnCommitHeaderPressed"
                              ToolTip.Tip="{Binding SelectedCommit.Message}"
                              ToolTip.ShowDelay="900"
                              ToolTip.Placement="BottomEdgeAlignedLeft"
                              ToolTip.VerticalOffset="6">
                            <SelectableTextBlock x:Name="HeaderHashText" Text="{Binding SelectedCommit.Hash}"
                                                 Foreground="{DynamicResource GitKayMutedTextBrush}"
                                                 FontFamily="{x:Static local:FontStacks.Mono}"
                                                 FontSize="12"
                                                 VerticalAlignment="Center"
                                                 Cursor="Hand"
                                                 PointerReleased="OnHashReleased"
                                                 ToolTip.Tip="Click to copy the full hash" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding SelectedCommit.Subject}"
                                       Foreground="{DynamicResource GitKayTextBrush}"
                                       FontSize="13"
                                       FontWeight="Normal"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap"
                                       VerticalAlignment="Center" />
                            <!-- Search progress and counts live in the search boxes; underlines mark matches in the diff. -->
                        </Grid>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                    IsVisible="{Binding IsRevisionComparison}">
                            <TextBlock Text="Revision diff:" Foreground="{DynamicResource GitKayMutedTextBrush}" VerticalAlignment="Center" />
                            <Button Classes="inline" Click="OnChangeRevisionComparison" ToolTip.Tip="Change the from and to revisions">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock Text="From" Foreground="{DynamicResource GitKayMutedTextBrush}" />
                                    <TextBlock Text="{Binding ComparisonBaseRevision}" FontFamily="{x:Static local:FontStacks.Mono}" />
                                    <TextBlock Text="to" Foreground="{DynamicResource GitKayMutedTextBrush}" />
                                    <TextBlock Text="{Binding ComparisonTargetRevision}" FontFamily="{x:Static local:FontStacks.Mono}" />
                                    <TextBlock Text="▾" Foreground="{DynamicResource GitKayMutedTextBrush}" />
                                </StackPanel>
                            </Button>
                            <Button Classes="inline" Click="OnCloseRevisionComparison" ToolTip.Tip="Return to selected commit diff">
                                <TextBlock Text="×" FontSize="16" />
                            </Button>
                        </StackPanel>

<Border Classes="keyHint" IsVisible="{Binding IsCtrlHintsVisible}" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="Ctrl+G  go to ref" /></Border>
<Border Classes="keyHint" IsVisible="{Binding IsCtrlHintsVisible}" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0"><TextBlock Text="Ctrl+F  find" /></Border>
                        <TextBox x:Name="CommitFindBox"
                                 Grid.Column="2"
                                 Width="220"
                                 Height="28"
                                 Text="{Binding CommitFindQuery, Mode=TwoWay}"
                                 PlaceholderText="{Binding CommitFindPlaceholder}">
<TextBox.InnerRightContent>
    <StackPanel Orientation="Horizontal" Spacing="2" Margin="0,0,4,0">
        <TextBlock Text="{Binding CommitFindStatusText}" Foreground="{DynamicResource GitKayMutedTextBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />
        <Button Classes="inline" Command="{Binding FindPreviousInCommitCommand}" ToolTip.Tip="Previous match (Shift+Enter, N)">
            <PathIcon Width="9" Height="9" Data="M2,11 L8,5 L14,11 L12.6,12.4 L8,7.8 L3.4,12.4 Z" Foreground="{DynamicResource GitKaySecondaryTextBrush}" />
        </Button>
        <Button Classes="inline" Command="{Binding FindInCommitCommand}" ToolTip.Tip="Next match (Enter, n)">
            <PathIcon Width="9" Height="9" Data="M2,5 L8,11 L14,5 L12.6,3.6 L8,8.2 L3.4,3.6 Z" Foreground="{DynamicResource GitKaySecondaryTextBrush}" />
        </Button>
        <ToggleButton Classes="inline" IsChecked="{Binding CommitFindUseRegex}" ToolTip.Tip="Regular expression">
            <TextBlock Text=".*" FontSize="11" FontFamily="{x:Static local:FontStacks.Mono}" />
        </ToggleButton>
    </StackPanel>
</TextBox.InnerRightContent>
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding FindInCommitCommand}" />
                                <KeyBinding Gesture="Shift+Enter" Command="{Binding FindPreviousInCommitCommand}" />
                            </TextBox.KeyBindings>
                        </TextBox>
                        <!-- Whitespace: on, lines that differ only in spacing drop out of the diff (git's -w). -->
                        <ToggleButton x:Name="IgnoreWhitespaceButton"
                                      Grid.Column="3"
                                      Classes="segment text"
                                      Classes.selected="{Binding IgnoreWhitespace}"
                                      Margin="0,0,6,0"
                                      IsChecked="{Binding IgnoreWhitespace, Mode=TwoWay}"
                                      ToolTip.Tip="Ignore whitespace changes — hides lines that differ only in spacing">
                            <!-- Keep a fixed width so toggling cannot move the neighbouring controls. -->
                            <Grid Width="74" Height="16">
                                <TextBlock Text="Whitespace" FontSize="10" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource GitKayTextBrush}" />
                            </Grid>
                        </ToggleButton>
                        <!-- Always here, saying so when there is nothing to put back: a reliable place to look
                             matters more for an irreversible-feeling action than the line of chrome it costs. -->
                        <Button Grid.Column="4" Classes="inline" Padding="10,3" Margin="0,0,6,0"
                                Command="{Binding UndoDiscardCommand}"
                                IsEnabled="{Binding CanUndoDiscard}"
                                ToolTip.Tip="{Binding UndoDiscardLabel}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <PathIcon Width="12" Height="12" Data="M3,7 H10 C12.2,7 14,8.8 14,11 C14,13.2 12.2,15 10,15 H4 V13.4 H10 C11.3,13.4 12.4,12.3 12.4,11 C12.4,9.7 11.3,8.6 10,8.6 H3 L5.6,11.2 L4.5,12.3 L0,7.8 L4.5,3.3 L5.6,4.4 Z"
                                          Foreground="{DynamicResource GitKaySecondaryTextBrush}" />
                                <TextBlock Text="Undo" FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Border x:Name="DiffModeButton"
                                Grid.Column="5"
                                Background="{DynamicResource GitKayRaisedBrush}"
                                BorderBrush="{DynamicResource GitKayBorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="1"
                                ContextRequested="OnDiffModeButtonContextRequested">
                        <StackPanel Orientation="Horizontal" Spacing="1">
                            <Button Classes="segment"
                                    Classes.selected="{Binding IsUnifiedDiffMode}"
                                    Command="{Binding SetDiffPresentationModeCommand}"
                                    CommandParameter="diff"
                                    ToolTip.Tip="Unified diff — changes inline">
                                <Canvas Width="16" Height="16">
                                    <Rectangle Canvas.Left="0.5" Canvas.Top="1.5" Width="15" Height="13" RadiusX="2" RadiusY="2" Stroke="{DynamicResource GitKaySecondaryTextBrush}" StrokeThickness="1" />
                                    <Rectangle Canvas.Left="3" Canvas.Top="5" Width="10" Height="2" Fill="{DynamicResource GitKayRemovedAccentBrush}" />
                                    <Rectangle Canvas.Left="3" Canvas.Top="9" Width="10" Height="2" Fill="{DynamicResource GitKayAddedAccentBrush}" />
                                </Canvas>
                            </Button>
                            <Button Classes="segment"
                                    Classes.selected="{Binding IsSideBySideDiffMode}"
                                    Command="{Binding SetDiffPresentationModeCommand}"
                                    CommandParameter="side-by-side"
                                    ToolTip.Tip="Side-by-side — old left, new right">
                                <Canvas Width="16" Height="16">
                                    <Rectangle Canvas.Left="0.5" Canvas.Top="1.5" Width="15" Height="13" RadiusX="2" RadiusY="2" Stroke="{DynamicResource GitKaySecondaryTextBrush}" StrokeThickness="1" />
                                    <Rectangle Canvas.Left="7.5" Canvas.Top="2" Width="1" Height="12" Fill="{DynamicResource GitKaySecondaryTextBrush}" />
                                    <Rectangle Canvas.Left="2.5" Canvas.Top="7" Width="4" Height="2" Fill="{DynamicResource GitKayRemovedAccentBrush}" />
                                    <Rectangle Canvas.Left="9.5" Canvas.Top="7" Width="4" Height="2" Fill="{DynamicResource GitKayAddedAccentBrush}" />
                                </Canvas>
                            </Button>
                            <Button Classes="segment"
                                    Classes.selected="{Binding IsNewDiffMode}"
                                    Command="{Binding SetDiffPresentationModeCommand}"
                                    CommandParameter="new"
                                    ToolTip.Tip="New file — after the change">
                                <Canvas Width="16" Height="16">
                                    <Path Data="M3,0.5 H10 L13.5,4 V15.5 H3 Z" Stroke="{DynamicResource GitKaySecondaryTextBrush}" StrokeThickness="1" />
                                    <Rectangle Canvas.Left="5" Canvas.Top="7.5" Width="6" Height="2" Fill="{DynamicResource GitKayAddedAccentBrush}" />
                                    <Rectangle Canvas.Left="7" Canvas.Top="5.5" Width="2" Height="6" Fill="{DynamicResource GitKayAddedAccentBrush}" />
                                </Canvas>
                            </Button>
                            <Button Classes="segment"
                                    Classes.selected="{Binding IsOldDiffMode}"
                                    Command="{Binding SetDiffPresentationModeCommand}"
                                    CommandParameter="old"
                                    ToolTip.Tip="Old file — before the change">
                                <Canvas Width="16" Height="16">
                                    <Path Data="M3,0.5 H10 L13.5,4 V15.5 H3 Z" Stroke="{DynamicResource GitKaySecondaryTextBrush}" StrokeThickness="1" />
                                    <Rectangle Canvas.Left="5" Canvas.Top="7.5" Width="6" Height="2" Fill="{DynamicResource GitKayRemovedAccentBrush}" />
                                </Canvas>
                            </Button>
                        </StackPanel>
                        </Border>

                    </Grid>
                </Border>

                    <Border x:Name="DiffPaneFocus" Grid.Row="1" Grid.Column="0" IsHitTestVisible="False" Background="{DynamicResource GitKayWindowBrush}" Opacity="0" ZIndex="10">
                        <Border.Transitions><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.12" /></Transitions></Border.Transitions>
                    </Border>
<Border Classes="keyHint" IsVisible="{Binding IsCtrlHintsVisible}" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,10,0"><TextBlock Text="Ctrl+3  files · Ctrl+P  go to file" /></Border>
                    <Border x:Name="FilesPaneFocus" Grid.Row="1" Grid.Column="2" IsHitTestVisible="False" Background="{DynamicResource GitKayWindowBrush}" Opacity="0" ZIndex="10">
                        <Border.Transitions><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.12" /></Transitions></Border.Transitions>
                    </Border>
                    <Border x:Name="DiffContentPart" Grid.Row="1" Grid.Column="0" Background="{DynamicResource GitKayWindowBrush}">
                        <DockPanel>
                        <!-- Commit details show within the diff column only; the file list keeps its layout. -->
                        <Border DockPanel.Dock="Top"
                                Padding="12,8,12,10"
                                Classes="fadeIn"
                                Background="{DynamicResource GitKaySurfaceBrush}"
                                BorderBrush="{DynamicResource GitKayHairlineBrush}"
                                BorderThickness="0,0,0,1"
                                IsVisible="{Binding IsCommitDetailsExpanded}">
                            <Grid ColumnDefinitions="Auto,*"
                                  RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                                  ColumnSpacing="12" RowSpacing="4"
                                  IsVisible="{Binding SelectedCommit, Converter={x:Static local:ObjectConverters.IsNotNull}}">

                                <TextBlock Grid.Row="1" Text="Hash" Foreground="{DynamicResource GitKayMutedTextBrush}" FontSize="11" />
                                <SelectableTextBlock x:Name="DetailHashText" Grid.Row="1" Grid.Column="1"
                                                     Text="{Binding SelectedCommit.FullHash}"
                                                     Foreground="{DynamicResource GitKaySecondaryTextBrush}"
                                                     FontFamily="{x:Static local:FontStacks.Mono}" FontSize="11"
                                                     HorizontalAlignment="Left"
                                                     Cursor="Hand"
                                                     PointerReleased="OnHashReleased"
                                                     ToolTip.Tip="Click to copy the full hash" />

                                <TextBlock Grid.Row="2" Text="Parents · children" Foreground="{DynamicResource GitKayMutedTextBrush}" FontSize="11" VerticalAlignment="Center" />
                                <WrapPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                    <ItemsControl ItemsSource="{Binding SelectedCommitParents}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="local:CommitLinkProjection">
                                                <Button Classes="commitLink" Command="{Binding $parent[Window].((local:MainProjection)DataContext).GoToCommitCommand}" CommandParameter="{Binding FullHash}"
                                                        ToolTip.Tip="{Binding Subject}">
                                                    <TextBlock><Run Text="↑ " /><Run Text="{Binding ShortHash}" FontFamily="{x:Static local:FontStacks.Mono}" /><Run Text="  " /><Run Text="{Binding Subject}" /></TextBlock>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding SelectedCommitChildren}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="local:CommitLinkProjection">
                                                <Button Classes="commitLink" Command="{Binding $parent[Window].((local:MainProjection)DataContext).GoToCommitCommand}" CommandParameter="{Binding FullHash}"
                                                        ToolTip.Tip="{Binding Subject}">
                                                    <TextBlock><Run Text="↓ " /><Run Text="{Binding ShortHash}" FontFamily="{x:Static local:FontStacks.Mono}" /><Run Text="  " /><Run Text="{Binding Subject}" /></TextBlock>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </WrapPanel>

                                <TextBlock Grid.Row="3" Text="Author" Foreground="{DynamicResource GitKayMutedTextBrush}" FontSize="11" />
                                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <SelectableTextBlock Text="{Binding SelectedCommit.Author}" Foreground="{DynamicResource GitKayTextBrush}" FontSize="11" />
                                    <SelectableTextBlock Text="{Binding SelectedCommit.AuthorEmail, StringFormat='&lt;{0}&gt;'}" Foreground="{DynamicResource GitKaySecondaryTextBrush}" FontSize="11" />
                                    <TextBlock Text="·" Foreground="{DynamicResource GitKayMutedTextBrush}" FontSize="11" />
                                    <TextBlock Text="{Binding SelectedCommit.FullDate}" Foreground="{DynamicResource GitKaySecondaryTextBrush}" FontSize="11" />
                                </StackPanel>

                                <TextBlock Grid.Row="4" Text="Refs" Foreground="{DynamicResource GitKayMutedTextBrush}" FontSize="11"
                                           IsVisible="{Binding SelectedCommit.HasRefBadges}" />
                                <ItemsControl Grid.Row="4" Grid.Column="1"
                                              ItemsSource="{Binding SelectedCommit.RefBadges}"
                                              IsVisible="{Binding SelectedCommit.HasRefBadges}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:CommitRefProjection">
                                            <Border Classes="refPill" Classes.remote="{Binding IsRemote}" Classes.tag="{Binding IsTag}" Classes.stash="{Binding IsStash}"
                                                    CornerRadius="8" Padding="6,1" Margin="0,0,4,0">
                                                <TextBlock Text="{Binding Text}" FontSize="11" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Grid.Row="5" Text="Message" Foreground="{DynamicResource GitKayMutedTextBrush}" FontSize="11"
                                           VerticalAlignment="Top" Margin="0,4,0,0"
                                           ToolTip.Tip="The whole message: its subject line and the body under it" />
                                <ScrollViewer Grid.Row="5" Grid.Column="1"
                                              MaxHeight="180" Margin="0,4,0,0"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <SelectableTextBlock Text="{Binding SelectedCommit.Message}"
                                                         Foreground="{DynamicResource GitKayTextBrush}"
                                                         FontFamily="{x:Static local:FontStacks.Mono}" FontSize="12"
                                                         TextWrapping="Wrap" />
                                </ScrollViewer>
                            </Grid>
                        </Border>
                            <Panel>
<Border Classes="keyHint" IsVisible="{Binding IsCtrlHintsVisible}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,6,0,0"><TextBlock Text="Ctrl+2  diff · Ctrl+C  copy" /></Border>
                            <ScrollViewer x:Name="DiffRowsScrollViewer"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <local:DiffSurfaceControl x:Name="DiffRowsListBox"
                                                          ItemsSource="{Binding SelectedDiffRows}"
                                                          SelectedItem="{Binding SelectedDiffRow, Mode=TwoWay}"
                                                          FindQuery="{Binding CommitFindQuery}"
                                                          FindUseRegex="{Binding CommitFindUseRegex}"
                                                          SearchHighlightQuery="{Binding CommitSearchDiffTerm}"
                                                          SearchPathQuery="{Binding CommitSearchPathTerm}"
                                                          SearchHighlightUseRegex="{Binding CommitSearchDiffTermUseRegex}"
                                                          DiffLayout="{Binding DiffLayout}"
                                                          CodeFontSize="{Binding DiffFontSize, Mode=TwoWay}"
                                                          OldRenderedImages="{Binding RenderedOldImages}"
                                                          RenderedImages="{Binding RenderedNewImages}"
                                                          RenderedImagesLoading="{Binding RenderedImagesLoading}"
                                                          FileContextRequested="OnDiffFileHeaderContextRequested"
                                                          ChangesOnlyRequested="OnDiffFileChangesOnlyRequested"
                                                          PreviewRequested="OnDiffFilePreviewRequested"
                                                          ExpandGapCommand="{Binding ExpandDiffGapCommand}"
                                                          ToggleFileCommand="{Binding ToggleDiffFileCollapsedCommand}"
                                                          ToggleFileContextCommand="{Binding ToggleDiffFileContextCommand}"
                                                          HorizontalAlignment="Stretch"
                                                          GotFocus="OnDiffRowsListBoxGotFocus" />
                            </ScrollViewer>
                                <local:OverviewRuler Width="4" HorizontalAlignment="Left" ZIndex="5"
                                                     Source="{Binding #DiffRowsListBox}" ToolTip.Tip="Changes and matches — click to jump" />
                            </Panel>
                        </DockPanel>
                    </Border>

                    <!-- Files header: same height as the diff header, over the files column. -->
                    <Border x:Name="FilesHeaderPart" Grid.Row="0" Grid.Column="2" MinHeight="37"
                            Background="{DynamicResource GitKayChromeBrush}"
                            BorderBrush="{DynamicResource GitKayHairlineBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="8,4">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Background="{DynamicResource GitKayRaisedBrush}"
                                    BorderBrush="{DynamicResource GitKayBorderBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="1"
                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="1">
                                    <Button Classes="segment"
                                            Classes.selected="{Binding IsPatchFileListMode}"
                                            Command="{Binding SetDiffFileListModeCommand}"
                                            CommandParameter="patch"
                                            ToolTip.Tip="Patch — changed files as full paths">
                                        <Canvas Width="16" Height="16">
                                            <Path Data="M3,0.5 H10 L13.5,4 V15.5 H3 Z" Stroke="{DynamicResource GitKaySecondaryTextBrush}" StrokeThickness="1" />
                                            <Rectangle Canvas.Left="5" Canvas.Top="6" Width="6" Height="1.5" Fill="{DynamicResource GitKayRemovedAccentBrush}" />
                                            <Rectangle Canvas.Left="5" Canvas.Top="9" Width="6" Height="1.5" Fill="{DynamicResource GitKayAddedAccentBrush}" />
                                            <Rectangle Canvas.Left="5" Canvas.Top="12" Width="4" Height="1.5" Fill="{DynamicResource GitKaySecondaryTextBrush}" />
                                        </Canvas>
                                    </Button>
                                    <Button Classes="segment"
                                            Classes.selected="{Binding IsTreeFileListMode}"
                                            Command="{Binding SetDiffFileListModeCommand}"
                                            CommandParameter="tree"
                                            ToolTip.Tip="Tree — changed files grouped by folder">
                                        <Canvas Width="16" Height="16">
                                            <Rectangle Canvas.Left="1" Canvas.Top="2" Width="6" Height="4" RadiusX="1" RadiusY="1" Stroke="{DynamicResource GitKaySecondaryTextBrush}" StrokeThickness="1" />
                                            <Path Data="M3.5,6 V13.5 H8 M3.5,9.5 H8" Stroke="{DynamicResource GitKaySecondaryTextBrush}" StrokeThickness="1" />
                                            <Rectangle Canvas.Left="9" Canvas.Top="8" Width="6" Height="3" RadiusX="1" RadiusY="1" Fill="{DynamicResource GitKayAccentBrush}" />
                                            <Rectangle Canvas.Left="9" Canvas.Top="12" Width="6" Height="3" RadiusX="1" RadiusY="1" Fill="{DynamicResource GitKayAccentBrush}" />
                                        </Canvas>
                                    </Button>
                                    <Button Classes="segment"
                                            Classes.selected="{Binding IsAllFilesMode}"
                                            Command="{Binding SetDiffFileListModeCommand}"
                                            CommandParameter="all"
                                            ToolTip.Tip="All files — every file in the commit, as a tree">
                                        <Canvas Width="16" Height="16">
                                            <!-- A stack of whole files: distinct from the tree glyph's folder and branches. -->
                                            <Path Data="M6,0.5 H12 L15.5,4 V11.5 H6 Z" Stroke="{DynamicResource GitKayMutedTextBrush}" StrokeThickness="1" />
                                            <Path Data="M3.5,2.5 H9.5 L13,6 V13.5 H3.5 Z" Fill="{DynamicResource GitKayRaisedBrush}" Stroke="{DynamicResource GitKaySecondaryTextBrush}" StrokeThickness="1" />
                                            <Path Data="M1,4.5 H7 L10.5,8 V15.5 H1 Z" Fill="{DynamicResource GitKayRaisedBrush}" Stroke="{DynamicResource GitKaySecondaryTextBrush}" StrokeThickness="1" />
                                            <Rectangle Canvas.Left="2.5" Canvas.Top="9" Width="5" Height="1.5" Fill="{DynamicResource GitKayAccentBrush}" />
                                            <Rectangle Canvas.Left="2.5" Canvas.Top="12" Width="6" Height="1.5" Fill="{DynamicResource GitKaySecondaryTextBrush}" />
                                        </Canvas>
                                    </Button>
                                </StackPanel>
                            </Border>
                            <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"
                                       IsVisible="{Binding HasDiffTotals}" ToolTip.Tip="Lines added and removed across the loaded files">
                                <Run Text="{Binding DiffTotalAddedText}" Foreground="{DynamicResource GitKayAddedAccentBrush}" /><Run Text="  " /><Run Text="{Binding DiffTotalRemovedText}" Foreground="{DynamicResource GitKayRemovedAccentBrush}" />
                            </TextBlock>
                        </Grid>
                    </Border>

                    <Border x:Name="FilesSplitterLine" Grid.Column="1" Grid.RowSpan="2" Width="1" HorizontalAlignment="Center" Background="{DynamicResource GitKayHairlineBrush}" IsHitTestVisible="False" />
                    <GridSplitter Grid.Column="1" Grid.RowSpan="2"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  ResizeDirection="Columns"
                                  ResizeBehavior="PreviousAndNext" />

                    <Border x:Name="FilesContentPart" Grid.Row="1" Grid.Column="2"
                            Background="{DynamicResource GitKaySurfaceBrush}"
                            Padding="8">
                        <DockPanel>
                            <ListBox x:Name="DiffFilesListBox"
                                     ItemsSource="{Binding DiffFileListRows}"
                                     SelectedItem="{Binding SelectedDiffFileListRow}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     SelectionMode="Single"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     GotFocus="OnDiffFilesListBoxGotFocus"
                                     ContextRequested="OnDiffFilesContextRequested"
                                     DoubleTapped="OnDiffFilesDoubleTapped">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                    </Style>
                                    <Style Selector="ListBoxItem:selected">
                                        <Setter Property="Background" Value="{DynamicResource GitKaySelectionBrush}" />
                                    </Style>
                                    <Style Selector="ListBoxItem:pointerover">
                                        <Setter Property="Background" Value="{DynamicResource GitKayHoverBrush}" />
                                    </Style>

                                        <Style Selector="TextBlock.pathMatch">
                                            <Setter Property="TextDecorations">
                                                <TextDecorationCollection>
                                                    <TextDecoration Location="Underline" StrokeThickness="1.5" StrokeDashArray="1,2" StrokeOffset="2"
                                                                    Stroke="{DynamicResource GitKayAccentBrush}" />
                                                </TextDecorationCollection>
                                            </Setter>
                                        </Style>
                                        <Style Selector="Border.fileChange.added">
                                            <Setter Property="BorderBrush" Value="{DynamicResource GitKayAddedAccentBrush}" />
                                        </Style>
                                        <Style Selector="Border.fileChange.added > TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource GitKayAddedAccentBrush}" />
                                        </Style>
                                        <Style Selector="Border.fileChange.deleted">
                                            <Setter Property="BorderBrush" Value="{DynamicResource GitKayRemovedAccentBrush}" />
                                        </Style>
                                        <Style Selector="Border.fileChange.deleted > TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource GitKayRemovedAccentBrush}" />
                                        </Style>
                                        <Style Selector="Border.fileChange.modified">
                                            <Setter Property="BorderBrush" Value="{DynamicResource GitKayMutedTextBrush}" />
                                        </Style>
                                        <Style Selector="Border.fileChange.modified > TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource GitKaySecondaryTextBrush}" />
                                        </Style>
                                </ListBox.Styles>
                                <ListBox.DataTemplates>
                                    <DataTemplate x:DataType="local:DiffFileFolderRow">
                                        <Border Padding="8,5" Background="Transparent" Cursor="Hand"
                                                PointerPressed="OnDiffFolderPointerPressed">
                                            <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="1" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0" IsVisible="{Binding HasChanges}">
                                                <Run Text="{Binding AddedText}" Foreground="{DynamicResource GitKayAddedAccentBrush}" /><Run Text=" " /><Run Text="{Binding RemovedText}" Foreground="{DynamicResource GitKayRemovedAccentBrush}" />
                                            </TextBlock>
                                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="{Binding Indent}">
                                                <Panel Width="10" Height="10" VerticalAlignment="Center">
                                                    <PathIcon Width="8" Height="8" Data="M5,2 L11,8 L5,14 L3.6,12.6 L8.2,8 L3.6,3.4 Z"
                                                              Foreground="{DynamicResource GitKaySecondaryTextBrush}"
                                                              IsVisible="{Binding !IsExpanded}" />
                                                    <PathIcon Width="8" Height="8" Data="M2,5 L8,11 L14,5 L12.6,3.6 L8,8.2 L3.4,3.6 Z"
                                                              Foreground="{DynamicResource GitKaySecondaryTextBrush}"
                                                              IsVisible="{Binding IsExpanded}" />
                                                </Panel>
                                                <PathIcon Width="14" Height="12" VerticalAlignment="Center"
                                                          Data="M1,3 C1,2 1.5,1.5 2.5,1.5 H6 L7.5,3 H13.5 C14.5,3 15,3.5 15,4.5 V12.5 C15,13.5 14.5,14 13.5,14 H2.5 C1.5,14 1,13.5 1,12.5 Z"
                                                          Foreground="{DynamicResource GitKayMutedTextBrush}" />
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource GitKaySecondaryTextBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                    <DataTemplate x:DataType="local:DiffFileSectionRow">
                                        <Border Padding="8,8,8,3" Background="Transparent">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource GitKaySecondaryTextBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding CountText}" FontSize="11"
                                                           Foreground="{DynamicResource GitKayMutedTextBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                    <DataTemplate x:DataType="local:RepoFileRow">
                                        <Border Padding="8,4" Background="Transparent">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7" Margin="{Binding Indent}" ToolTip.Tip="Unchanged — Enter or double-click shows the whole file">
                                                <Border Width="14" Height="14" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12"
                                                           Foreground="{DynamicResource GitKayMutedTextBrush}"
                                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                    <DataTemplate x:DataType="local:DiffFileProjection">
                                        <Border Padding="8,4"
                                                Background="Transparent"
                                                BorderThickness="0">
                                            <local:ChangedFileRow Indent="{Binding ListIndent}"
                                                                  ToolTip.Tip="{Binding ChangeToolTip}"
                                                                  Marker="{Binding ListMarker}"
                                                                  Glyph="{Binding ChangeGlyph}"
                                                                  Label="{Binding ListLabel}"
                                                                  AddedText="{Binding AddedText}"
                                                                  RemovedText="{Binding RemovedText}"
                                                                  ShowsCounts="{Binding ShowsCounts}"
                                                                  IsAdded="{Binding IsAddedFile}"
                                                                  IsDeleted="{Binding IsDeletedFile}"
                                                                  IsModified="{Binding IsModifiedFile}"
                                                                  IsSearchMatch="{Binding IsPathSearchMatch}" />
                                        </Border>
                                    </DataTemplate>
                                </ListBox.DataTemplates>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- Palette: commands (Ctrl+Shift+P or :), refs and commits (Ctrl+G), changed files (Ctrl+P). -->
        <Border IsVisible="{Binding IsPaletteOpen}" Classes="fadeIn"
                Background="#33000000"
                ZIndex="40"
                PointerPressed="OnPaletteBackdropPressed">
            <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,70,0,0"
                    Width="680" MaxHeight="520" CornerRadius="8" Padding="6"
                    Background="{DynamicResource GitKaySurfaceBrush}"
                    BorderBrush="{DynamicResource GitKayBorderBrush}" BorderThickness="1"
                    BoxShadow="0 12 32 0 #50000000"
                    PointerPressed="OnPalettePanelPressed">
                <DockPanel>
                    <TextBox x:Name="PaletteBox" DockPanel.Dock="Top" Height="34" FontSize="14"
                             Text="{Binding PaletteQuery, Mode=TwoWay}"
                             PlaceholderText="{Binding PalettePlaceholder}" />
                    <ListBox x:Name="PaletteList" Margin="0,6,0,0"
                             ItemsSource="{Binding PaletteItems}"
                             SelectedIndex="{Binding PaletteSelectedIndex, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0"
                             PointerReleased="OnPaletteListPointerReleased">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="8,5" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="CornerRadius" Value="4" />
                            </Style>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="{DynamicResource GitKaySelectionBrush}" />
                            </Style>
                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="{DynamicResource GitKayHoverBrush}" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="local:PaletteItem">
                                <Grid ColumnDefinitions="22,*,Auto" Margin="2,1">
                                    <TextBlock Text="{Binding Glyph}" Foreground="{DynamicResource GitKayMutedTextBrush}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="13" Foreground="{DynamicResource GitKayTextBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource GitKayMutedTextBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Border Grid.Column="2" IsVisible="{Binding HasShortcut}" Padding="6,1" CornerRadius="3"
                                            Background="{DynamicResource GitKayRaisedBrush}" BorderBrush="{DynamicResource GitKayBorderBrush}" BorderThickness="1">
                                        <TextBlock Text="{Binding Shortcut}" FontSize="11" FontFamily="{x:Static local:FontStacks.Mono}" Foreground="{DynamicResource GitKaySecondaryTextBrush}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Border>

        <!-- Keyboard shortcut sheet: F1 (or ? outside the panes). -->
        <Border IsVisible="{Binding IsShortcutHelpOpen}" Classes="fadeIn"
                Background="#66000000"
                ZIndex="30"
                PointerPressed="OnShortcutHelpBackdropPressed">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="600" MaxHeight="760" Padding="20,14,20,18" CornerRadius="8"
                    Background="{DynamicResource GitKaySurfaceBrush}"
                    BorderBrush="{DynamicResource GitKayBorderBrush}" BorderThickness="1"
                    BoxShadow="0 12 32 0 #50000000">
                <StackPanel>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Keyboard shortcuts" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource GitKayTextBrush}" />
                        <TextBlock Grid.Column="1" Text="F1 or Esc to close" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource GitKayMutedTextBrush}" />
                    </Grid>
                    <StackPanel>
                        <TextBlock Text="General" FontWeight="SemiBold" FontSize="12" Margin="0,10,0,4" Foreground="{DynamicResource GitKayAccentBrush}" />
                        <Grid ColumnDefinitions="200,*" Margin="0,2">
                            <TextBlock Text="Ctrl+F  or  /" FontFamily="{x:Static local:FontStacks.Mono}" FontSize="12" Foreground="{DynamicResource GitKayTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Search commits — or the diff, when the diff has focus" FontSize="12" Foreground="{DynamicResource GitKaySecondaryTextBrush}" TextWrapping="Wrap" />
                        </Grid>
                        <Grid ColumnDefinitions="200,*" Margin="0,2">
                            <TextBlock Text="F1" FontFamily="{x:Static local:FontStacks.Mono}" FontSize="12" Foreground="{DynamicResource GitKayTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Show or hide these shortcuts — or hold Ctrl to see Ctrl shortcuts on screen" FontSize="12" Foreground="{DynamicResource GitKaySecondaryTextBrush}" TextWrapping="Wrap" />
                        </Grid>
                        <Grid ColumnDefinitions="200,*" Margin="0,2">
                            <TextBlock Text="Esc" FontFamily="{x:Static local:FontStacks.Mono}" FontSize="12" Foreground="{DynamicResource GitKayTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Cancel a running search, then clear it / close popup" FontSize="12" Foreground="{DynamicResource GitKaySecondaryTextBrush}" TextWrapping="Wrap" />
                        </Grid>
                        <Grid ColumnDefinitions="200,*" Margin="0,2">
                            <TextBlock Text="Ctrl+Shift+D" FontFamily="{x:Static local:FontStacks.Mono}" FontSize="12" Foreground="{DynamicResource GitKayTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Diagnostics — live Axial flows, failures, messages and log" FontSize="12" Foreground="{DynamicResource GitKaySecondaryTextBrush}" TextWrapping="Wrap" />
                        </Grid>
                        <TextBlock Text="Go to" FontWeight="SemiBold" FontSize="12" Margin="0,10,0,4" Foreground="{DynamicResource GitKayAccentBrush}" />
                        <Grid ColumnDefinitions="200,*" Margin="0,2">
                            <TextBlock Text="Ctrl+Shift+P  or  :" FontFamily="{x:Static local:FontStacks.Mono}" FontSize="12" Foreground="{DynamicResource GitKayTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Command palette" FontSize="12" Foreground="{DynamicResource GitKaySecondaryTextBrush}" TextWrapping="Wrap" />
                        </Grid>
                        <Grid ColumnDefinitions="200,*" Margin="0,2">
                            <TextBlock Text="Ctrl+G" FontFamily="{x:Static local:FontStacks.Mono}" FontSize="12" Foreground="{DynamicResource GitKayTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Go to branch, tag or commit" FontSize="12" Foreground="{DynamicResource GitKaySecondaryTextBrush}" TextWrapping="Wrap" />
                        </Grid>
                        <Grid ColumnDefinitions="200,*" Margin="0,2">
                            <TextBlock Text="Ctrl+P" FontFamily="{x:Static local:FontStacks.Mono}" FontSize="12" Foreground="{DynamicResource GitKayTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Go to changed file" FontSize="12" Foreground="{DynamicResource GitKaySecondaryTextBrush}" TextWrapping="Wrap" />
                        </Grid>
                        <Grid ColumnDefinitions="200,*" Margin="0,2">
                            <TextBlock Text="Alt+← / Alt+→" FontFamily="{x:Static local:FontStacks.Mono}" FontSize="12" Foreground="{DynamicResource GitKayTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Back / forward (also Ctrl+O / Ctrl+I)" FontSize="12" Foreground="{DynamicResource GitKaySecondaryTextBrush}" TextWrapping="Wrap" />
                        </Grid>
                        <Grid ColumnDefinitions="200,*" Margin="0,2">
                            <TextBlock Text="p / Shift+P / c" FontFamily="{x:Static local:FontStacks.Mono}" FontSize="12" Foreground="{DynamicResource GitKayTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Parent / second parent / child" FontSize="12" Foreground="{DynamicResource GitKaySecondaryTextBrush}" TextWrapping="Wrap" />
                        </Grid>
                        <Grid ColumnDefinitions="200,*" Margin="0,2">
                            <TextBlock Text="y / Y" FontFamily="{x:Static local:FontStacks.Mono}" FontSize="12" Foreground="{DynamicResource GitKayTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Copy commit hash / subject (in the diff with a line focused, y and Y copy text instead)" FontSize="12" Foreground="{DynamicResource GitKaySecondaryTextBrush}" TextWrapping="Wrap" />
                        </Grid>
                        <TextBlock Text="Moving" FontWeight="SemiBold" FontSize="12" Margin="0,10,0,4" Foreground="{DynamicResource GitKayAccentBrush}" />
                        <Grid ColumnDefinitions="200,*" Margin="0,2">
                            <TextBlock Text="j / k   ↓ / ↑" FontFamily="{x:Static local:FontStacks.Mono}" FontSize="12" Foreground="{DynamicResource GitKayTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Next / previous row" FontSize="12" Foreground="{DynamicResource GitKaySecondaryTextBrush}" TextWrapping="Wrap" />
                        </Grid>
                        <Grid ColumnDefinitions="200,*" Margin="0,2">
                            <TextBlock Text="Ctrl+h/j/k/l" FontFamily="{x:Static local:FontStacks.Mono}" FontSize="12" Foreground="{DynamicResource GitKayTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Pane left / down / up / right" FontSize="12" Foreground="{DynamicResource GitKaySecondaryTextBrush}" TextWrapping="Wrap" />
                        </Grid>
                        <Grid ColumnDefinitions="200,*" Margin="0,2">
                            <TextBlock Text="Tab / Shift+Tab" FontFamily="{x:Static local:FontStacks.Mono}" FontSize="12" Foreground="{DynamicResource GitKayTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Next / previous pane" FontSize="12" Foreground="{DynamicResource GitKaySecondaryTextBrush}" TextWrapping="Wrap" />
                        </Grid>
                        <Grid ColumnDefinitions="200,*" Margin="0,2">
                            <TextBlock Text="Ctrl+1 / 2 / 3" FontFamily="{x:Static local:FontStacks.Mono}" FontSize="12" Foreground="{DynamicResource GitKayTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Commits / diff / files" FontSize="12" Foreground="{DynamicResource GitKaySecondaryTextBrush}" TextWrapping="Wrap" />
                        </Grid>
                        <Grid ColumnDefinitions="200,*" Margin="0,2">
                            <TextBlock Text="Enter / Esc" FontFamily="{x:Static local:FontStacks.Mono}" FontSize="12" Foreground="{DynamicResource GitKayTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Open in diff / back to commits" FontSize="12" Foreground="{DynamicResource GitKaySecondaryTextBrush}" TextWrapping="Wrap" />
                        </Grid>
                        <Grid ColumnDefinitions="200,*" Margin="0,2">
                            <TextBlock Text="gg / G   Home / End" FontFamily="{x:Static local:FontStacks.Mono}" FontSize="12" Foreground="{DynamicResource GitKayTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Top / bottom" FontSize="12" Foreground="{DynamicResource GitKaySecondaryTextBrush}" TextWrapping="Wrap" />
                        </Grid>
                        <Grid ColumnDefinitions="200,*" Margin="0,2">
                            <TextBlock Text="Ctrl+D / Ctrl+U" FontFamily="{x:Static local:FontStacks.Mono}" FontSize="12" Foreground="{DynamicResource GitKayTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Half page down / up" FontSize="12" Foreground="{DynamicResource GitKaySecondaryTextBrush}" TextWrapping="Wrap" />
                        </Grid>
                        <TextBlock Text="Searching" FontWeight="SemiBold" FontSize="12" Margin="0,10,0,4" Foreground="{DynamicResource GitKayAccentBrush}" />
                        <Grid ColumnDefinitions="200,*" Margin="0,2">
                            <TextBlock Text="Enter / Shift+Enter" FontFamily="{x:Static local:FontStacks.Mono}" FontSize="12" Foreground="{DynamicResource GitKayTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Next / previous match" FontSize="12" Foreground="{DynamicResource GitKaySecondaryTextBrush}" TextWrapping="Wrap" />
                        </Grid>
                        <Grid ColumnDefinitions="200,*" Margin="0,2">
                            <TextBlock Text="n / N" FontFamily="{x:Static local:FontStacks.Mono}" FontSize="12" Foreground="{DynamicResource GitKayTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Next / previous match (commits or diff)" FontSize="12" Foreground="{DynamicResource GitKaySecondaryTextBrush}" TextWrapping="Wrap" />
                        </Grid>
                        <Grid ColumnDefinitions="200,*" Margin="0,2">
                            <TextBlock Text="author: path: diff:" FontFamily="{x:Static local:FontStacks.Mono}" FontSize="12" Foreground="{DynamicResource GitKayTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Filter by field; also message: hash: ref: after: before:" FontSize="12" Foreground="{DynamicResource GitKaySecondaryTextBrush}" TextWrapping="Wrap" />
                        </Grid>
                        <Grid ColumnDefinitions="200,*" Margin="0,2">
                            <TextBlock Text=".*" FontFamily="{x:Static local:FontStacks.Mono}" FontSize="12" Foreground="{DynamicResource GitKayTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Regular expression toggle" FontSize="12" Foreground="{DynamicResource GitKaySecondaryTextBrush}" TextWrapping="Wrap" />
                        </Grid>
                        <TextBlock Text="Uncommitted changes" FontWeight="SemiBold" FontSize="12" Margin="0,10,0,4" Foreground="{DynamicResource GitKayAccentBrush}" />
                        <Grid ColumnDefinitions="200,*" Margin="0,2">
                            <TextBlock Text="s / u" FontFamily="{x:Static local:FontStacks.Mono}" FontSize="12" Foreground="{DynamicResource GitKayTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Stage / unstage: the selected lines or the hunk at the cursor in the diff, the file in the files list" FontSize="12" Foreground="{DynamicResource GitKaySecondaryTextBrush}" TextWrapping="Wrap" />
                        </Grid>
                        <Grid ColumnDefinitions="200,*" Margin="0,2">
                            <TextBlock Text="Delete · Ctrl+Z" FontFamily="{x:Static local:FontStacks.Mono}" FontSize="12" Foreground="{DynamicResource GitKayTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Discard them (asks first) · put back what the last discard threw away" FontSize="12" Foreground="{DynamicResource GitKaySecondaryTextBrush}" TextWrapping="Wrap" />
                        </Grid>
                        <Grid ColumnDefinitions="200,*" Margin="0,2">
                            <TextBlock Text="Ctrl+Shift+C · Enter" FontFamily="{x:Static local:FontStacks.Mono}" FontSize="12" Foreground="{DynamicResource GitKayTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Open the commit window (Enter on the Uncommitted changes row); right-click the newest commit to amend it" FontSize="12" Foreground="{DynamicResource GitKaySecondaryTextBrush}" TextWrapping="Wrap" />
                        </Grid>
                        <TextBlock Text="Diff" FontWeight="SemiBold" FontSize="12" Margin="0,10,0,4" Foreground="{DynamicResource GitKayAccentBrush}" />
                        <Grid ColumnDefinitions="200,*" Margin="0,2">
                            <TextBlock Text="Enter / Space" FontFamily="{x:Static local:FontStacks.Mono}" FontSize="12" Foreground="{DynamicResource GitKayTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="On a file: collapse / expand (Shift: all context) · on a gap: show hidden lines" FontSize="12" Foreground="{DynamicResource GitKaySecondaryTextBrush}" TextWrapping="Wrap" />
                        </Grid>
                        <Grid ColumnDefinitions="200,*" Margin="0,2">
                            <TextBlock Text="h / l · w / b / e · W / B / E · 0 / $" FontFamily="{x:Static local:FontStacks.Mono}" FontSize="12" Foreground="{DynamicResource GitKayTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Move the caret by character, word, WORD (to whitespace), or to the line ends (crosses sides in side-by-side)" FontSize="12" Foreground="{DynamicResource GitKaySecondaryTextBrush}" TextWrapping="Wrap" />
                        </Grid>
                        <Grid ColumnDefinitions="200,*" Margin="0,2">
                            <TextBlock Text="^ / _ · %" FontFamily="{x:Static local:FontStacks.Mono}" FontSize="12" Foreground="{DynamicResource GitKayTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="First non-blank character · the bracket matching the next one on the line" FontSize="12" Foreground="{DynamicResource GitKaySecondaryTextBrush}" TextWrapping="Wrap" />
                        </Grid>
                        <Grid ColumnDefinitions="200,*" Margin="0,2">
                            <TextBlock Text="{}{count}" FontFamily="{x:Static local:FontStacks.Mono}" FontSize="12" Foreground="{DynamicResource GitKayTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{}Repeat a motion (3j, 5w, 2fx, y3w, 3]c) · {count}G / {count}gg: commit N, or line N in the focused file" FontSize="12" Foreground="{DynamicResource GitKaySecondaryTextBrush}" TextWrapping="Wrap" />
                        </Grid>
                        <Grid ColumnDefinitions="200,*" Margin="0,2">
                            <TextBlock Text="* / #" FontFamily="{x:Static local:FontStacks.Mono}" FontSize="12" Foreground="{DynamicResource GitKayTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Find the word under the caret forwards / backwards; n and N continue" FontSize="12" Foreground="{DynamicResource GitKaySecondaryTextBrush}" TextWrapping="Wrap" />
                        </Grid>
                        <Grid ColumnDefinitions="200,*" Margin="0,2">
                            <TextBlock Text="/ · ?" FontFamily="{x:Static local:FontStacks.Mono}" FontSize="12" Foreground="{DynamicResource GitKayTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Search forwards · backwards in the status bar (regex, smartcase; /i ignores case, \V literal from there on and \v back to regex, Alt+R / Alt+C toggle); Enter keeps it for n / N, Esc cancels. Ctrl+F opens the find box. F1 opens this sheet" FontSize="12" Foreground="{DynamicResource GitKaySecondaryTextBrush}" TextWrapping="Wrap" />
                        </Grid>
                        <Grid ColumnDefinitions="200,*" Margin="0,2">
                            <TextBlock Text="zz / zt / zb" FontFamily="{x:Static local:FontStacks.Mono}" FontSize="12" Foreground="{DynamicResource GitKayTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Scroll so the focused row sits at the centre / top / bottom" FontSize="12" Foreground="{DynamicResource GitKaySecondaryTextBrush}" TextWrapping="Wrap" />
                        </Grid>
                        <Grid ColumnDefinitions="200,*" Margin="0,2">
                            <TextBlock Text="PageUp / PageDown" FontFamily="{x:Static local:FontStacks.Mono}" FontSize="12" Foreground="{DynamicResource GitKayTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="A screen of commits or diff rows down / up (the files list moves 20)" FontSize="12" Foreground="{DynamicResource GitKaySecondaryTextBrush}" TextWrapping="Wrap" />
                        </Grid>
                        <Grid ColumnDefinitions="200,*" Margin="0,2">
                            <TextBlock Text="H / M / L" FontFamily="{x:Static local:FontStacks.Mono}" FontSize="12" Foreground="{DynamicResource GitKayTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Focus the top / middle / bottom row on screen (3H: third from the top)" FontSize="12" Foreground="{DynamicResource GitKaySecondaryTextBrush}" TextWrapping="Wrap" />
                        </Grid>
                        <Grid ColumnDefinitions="200,*" Margin="0,2">
                            <TextBlock Text="Ctrl+W  h / j / k / l" FontFamily="{x:Static local:FontStacks.Mono}" FontSize="12" Foreground="{DynamicResource GitKayTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Move to the pane left / below / above / right (also arrows, or with Ctrl held); w / W cycle; p goes back" FontSize="12" Foreground="{DynamicResource GitKaySecondaryTextBrush}" TextWrapping="Wrap" />
                        </Grid>
                        <Grid ColumnDefinitions="200,*" Margin="0,2">
                            <TextBlock Text="Ctrl+W  o · _ · | · =" FontFamily="{x:Static local:FontStacks.Mono}" FontSize="12" Foreground="{DynamicResource GitKayTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Maximise the focused pane (o toggles) · maximise its height · its width · restore the layout" FontSize="12" Foreground="{DynamicResource GitKaySecondaryTextBrush}" TextWrapping="Wrap" />
                        </Grid>
                        <Grid ColumnDefinitions="200,*" Margin="0,2">
                            <TextBlock Text="Ctrl+E / Ctrl+Y" FontFamily="{x:Static local:FontStacks.Mono}" FontSize="12" Foreground="{DynamicResource GitKayTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Scroll one row down / up; the focus stays unless it would leave the screen" FontSize="12" Foreground="{DynamicResource GitKaySecondaryTextBrush}" TextWrapping="Wrap" />
                        </Grid>
                        <Grid ColumnDefinitions="200,*" Margin="0,2">
                            <TextBlock Text="f / F / t / T  x · ; / ," FontFamily="{x:Static local:FontStacks.Mono}" FontSize="12" Foreground="{DynamicResource GitKayTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Jump to (f) or just before (t) the next x on the line, backwards with Shift; ; repeats, , reverses" FontSize="12" Foreground="{DynamicResource GitKaySecondaryTextBrush}" TextWrapping="Wrap" />
                        </Grid>
                        <Grid ColumnDefinitions="200,*" Margin="0,2">
                            <TextBlock Text="v / V  then  y" FontFamily="{x:Static local:FontStacks.Mono}" FontSize="12" Foreground="{DynamicResource GitKayTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Select from the caret (v: characters, V: lines; extend with any motion), then yank" FontSize="12" Foreground="{DynamicResource GitKaySecondaryTextBrush}" TextWrapping="Wrap" />
                        </Grid>
                        <Grid ColumnDefinitions="200,*" Margin="0,2">
                            <TextBlock Text="yy / Y · y{motion}" FontFamily="{x:Static local:FontStacks.Mono}" FontSize="12" Foreground="{DynamicResource GitKayTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Copy the line, or from the caret to a motion (yw, ye, y$, yfx, yt), …)" FontSize="12" Foreground="{DynamicResource GitKaySecondaryTextBrush}" TextWrapping="Wrap" />
                        </Grid>
                        <Grid ColumnDefinitions="200,*" Margin="0,2">
                            <TextBlock Text="yi / ya  w W ( [ { &lt; &quot; ' `" FontFamily="{x:Static local:FontStacks.Mono}" FontSize="12" Foreground="{DynamicResource GitKayTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Copy inside or around a word, WORD, brackets (b = (), B = {}) or quotes on the line" FontSize="12" Foreground="{DynamicResource GitKaySecondaryTextBrush}" TextWrapping="Wrap" />
                        </Grid>
                        <Grid ColumnDefinitions="200,*" Margin="0,2">
                            <TextBlock Text="Ctrl+= / Ctrl+- / Ctrl+0" FontFamily="{x:Static local:FontStacks.Mono}" FontSize="12" Foreground="{DynamicResource GitKayTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Zoom diff text in / out / reset (also Ctrl+wheel)" FontSize="12" Foreground="{DynamicResource GitKaySecondaryTextBrush}" TextWrapping="Wrap" />
                        </Grid>
                        <Grid ColumnDefinitions="200,*" Margin="0,2">
                            <TextBlock Text="]c / [c" FontFamily="{x:Static local:FontStacks.Mono}" FontSize="12" Foreground="{DynamicResource GitKayTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Next / previous hunk" FontSize="12" Foreground="{DynamicResource GitKaySecondaryTextBrush}" TextWrapping="Wrap" />
                        </Grid>
                        <Grid ColumnDefinitions="200,*" Margin="0,2">
                            <TextBlock Text="Right-click view modes" FontFamily="{x:Static local:FontStacks.Mono}" FontSize="12" Foreground="{DynamicResource GitKayTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Context lines" FontSize="12" Foreground="{DynamicResource GitKaySecondaryTextBrush}" TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <Grid IsVisible="{Binding IsInitialLoading}"
              Background="{DynamicResource GitKayWindowBrush}"
              RowDefinitions="3*,6,7*"
              Panel.ZIndex="10"
              IsHitTestVisible="False">
            <Border Background="{DynamicResource GitKayWindowBrush}"
                    BorderBrush="{DynamicResource GitKayBorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid RowDefinitions="24,*">
                    <Border Background="{DynamicResource GitKayRaisedBrush}" />
                    <StackPanel Grid.Row="1" Margin="56,14,24,0" Spacing="12">
                        <Border Width="420" Height="8" HorizontalAlignment="Left" CornerRadius="4" Background="{DynamicResource GitKayRaisedBrush}" />
                        <Border Width="570" Height="8" HorizontalAlignment="Left" CornerRadius="4" Background="{DynamicResource GitKayRaisedBrush}" />
                        <Border Width="360" Height="8" HorizontalAlignment="Left" CornerRadius="4" Background="{DynamicResource GitKayRaisedBrush}" />
                        <Border Width="510" Height="8" HorizontalAlignment="Left" CornerRadius="4" Background="{DynamicResource GitKayRaisedBrush}" />
                        <Border Width="450" Height="8" HorizontalAlignment="Left" CornerRadius="4" Background="{DynamicResource GitKayRaisedBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Row="2" Background="{DynamicResource GitKaySurfaceBrush}">
                <Grid RowDefinitions="52,*">
                    <Border Background="{DynamicResource GitKayRaisedBrush}" BorderBrush="{DynamicResource GitKayBorderBrush}" BorderThickness="0,0,0,1" />
                    <StackPanel Grid.Row="1" Margin="60,18,24,0" Spacing="11">
                        <Border Width="620" Height="8" HorizontalAlignment="Left" CornerRadius="4" Background="{DynamicResource GitKayRaisedBrush}" />
                        <Border Width="700" Height="8" HorizontalAlignment="Left" CornerRadius="4" Background="{DynamicResource GitKayRaisedBrush}" />
                        <Border Width="540" Height="8" HorizontalAlignment="Left" CornerRadius="4" Background="{DynamicResource GitKayRaisedBrush}" />
                        <Border Width="650" Height="8" HorizontalAlignment="Left" CornerRadius="4" Background="{DynamicResource GitKayRaisedBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        </Grid>
    </DockPanel>
</Window>
