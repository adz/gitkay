<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GitKay.UI"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="GitKay.UI.MainWindow"
        x:DataType="local:MainProjection"
        Title="GitKay">

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Reread refs" Command="{Binding RereadRefs}" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Bottom" Background="#007acc" Padding="4">
            <TextBlock Text="{Binding Status}" Foreground="White" FontSize="12" />
        </Border>

        <Grid RowDefinitions="250,Auto,*">
            <Border Grid.Row="0" Background="#1e1e1e" BorderBrush="#333" BorderThickness="0,0,0,1">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0"
                            Background="#252526"
                            BorderBrush="#333"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10"
                            Margin="6,6,6,4">
                        <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
                                <TextBlock Text="Search"
                                           Foreground="#ddd"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="0,0,4,0" />

                                <TextBox Grid.Column="1"
                                         MinWidth="320"
                                         HorizontalAlignment="Stretch"
                                         Text="{Binding SearchQuery, Mode=TwoWay}"
                                         PlaceholderText="Search hash, message, author, path, text, ref">
                                    <TextBox.KeyBindings>
                                        <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
                                    </TextBox.KeyBindings>
                                </TextBox>

                                <ComboBox Grid.Column="2"
                                          Width="160"
                                          ItemsSource="{Binding SearchScopes}"
                                          SelectedItem="{Binding SelectedSearchScope}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="local:SearchScopeProjection">
                                            <TextBlock Text="{Binding Label}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <Button Grid.Column="3"
                                        Content="_Search"
                                        Command="{Binding SearchCommand}" />
                                <Button Grid.Column="4"
                                        Content="_Clear"
                                        Command="{Binding ClearSearchCommand}" />
                            </Grid>

                            <Border Grid.Row="1"
                                    Background="#1f1f1f"
                                    BorderBrush="#333"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8"
                                    IsVisible="{Binding IsSearchPanelExpanded}">
                                <Grid RowDefinitions="Auto,*" RowSpacing="6">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Search results"
                                                   Foreground="#ddd"
                                                   FontWeight="SemiBold"
                                                   FontSize="11" />
                                        <TextBlock Text="Press Enter to search the current query. The scope menu narrows which fields are matched."
                                                   Foreground="#888"
                                                   FontSize="11"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <ListBox x:Name="SearchResultsListBox"
                                             Grid.Row="1"
                                             ItemsSource="{Binding SearchResults}"
                                             SelectedItem="{Binding SelectedSearchResult}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             SelectionMode="Single"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             MaxHeight="140">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.Styles>
                                            <Style Selector="ListBoxItem">
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="0" />
                                            </Style>
                                            <Style Selector="ListBoxItem:selected">
                                                <Setter Property="Background" Value="#333" />
                                            </Style>
                                            <Style Selector="ListBoxItem:pointerover">
                                                <Setter Property="Background" Value="#2a2a2a" />
                                            </Style>
                                        </ListBox.Styles>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="local:SearchResultProjection">
                                                <Border Padding="8,6">
                                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="2">
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding Subject}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#ddd"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Hash}"
                                                                   Foreground="#888"
                                                                   VerticalAlignment="Center"
                                                                   Margin="10,0,0,0"
                                                                   FontFamily="Cascadia Code,Consolas,Monospace"
                                                                   FontSize="11" />
                                                        <StackPanel Grid.Row="1"
                                                                    Grid.ColumnSpan="2"
                                                                    Orientation="Horizontal"
                                                                    Spacing="12">
                                                            <TextBlock Text="{Binding Author}"
                                                                       Foreground="#aaa"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="11"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Date}"
                                                                       Foreground="#888"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="11" />
                                                            <TextBlock Text="{Binding MatchSummary}"
                                                                       Foreground="#4ec9b0"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="11"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <ListBox x:Name="CommitListBox"
                             ItemsSource="{Binding Commits}"
                             SelectedItem="{Binding SelectedCommit}"
                             Background="Transparent"
                             BorderThickness="0"
                             KeyDown="OnCommitListBoxKeyDown">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="local:CommitProjection">
                                        <Grid ColumnDefinitions="150,100,*,150,150" Background="Transparent">
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Create _Tag here..." Command="{Binding CreateTagCommand}" />
                                            <MenuItem Header="Create _Branch here..." Command="{Binding CreateBranchCommand}" />
                                            <Separator />
                                            <MenuItem Header="_Cherry-pick this commit" Command="{Binding CherryPickCommand}" />
                                            <MenuItem Header="_Revert this commit" Command="{Binding RevertCommand}" />
                                            <Separator />
                                            <MenuItem Header="_Reset current branch to here">
                                                <MenuItem Header="_Soft" Command="{Binding ResetSoftCommand}" />
                                                <MenuItem Header="_Hard" Command="{Binding ResetHardCommand}" />
                                            </MenuItem>
                                        </ContextMenu>
                                    </Grid.ContextMenu>

                                    <local:GraphRowControl Grid.Column="0" Segments="{Binding Segments}" CommitLane="{Binding Lane}" Height="28"/>

                                    <TextBlock Grid.Column="1" Text="{Binding Hash}" Foreground="#888" Margin="4,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="2" Margin="4,1" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="{Binding Subject}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding RefsSummary}"
                                                   IsVisible="{Binding HasRefs}"
                                                   Foreground="#4ec9b0"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="3" Text="{Binding Author}" Foreground="#aaa" Margin="4,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Date}" Foreground="#888" Margin="4,0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

                <Border Grid.Row="1" Background="#252526" BorderBrush="#333" BorderThickness="0,1" Padding="8,6">
                    <StackPanel Spacing="3" IsVisible="{Binding SelectedCommit, Converter={x:Static local:ObjectConverters.IsNotNull}}">
                        <SelectableTextBlock Text="{Binding SelectedCommit.FullHash}" Foreground="#4ec9b0" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Text="{Binding SelectedCommit.RefsSummary}"
                                   IsVisible="{Binding SelectedCommit.HasRefs}"
                                   Foreground="#4ec9b0"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="{Binding SelectedCommit.Author}" Foreground="#aaa" FontSize="12"/>
                            <TextBlock Text="{Binding SelectedCommit.Date}" Foreground="#888" FontSize="12"/>
                        </StackPanel>
                        <SelectableTextBlock Text="{Binding SelectedCommit.Subject}" FontSize="14" Foreground="#ddd" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="2" ColumnDefinitions="*,4,280" Background="#1e1e1e">
                <Border Grid.Column="0" Background="#1e1e1e" BorderBrush="#333" BorderThickness="0,1,0,0">
                    <ListBox x:Name="DiffRowsListBox"
                             ItemsSource="{Binding SelectedDiffRows}"
                             SelectedItem="{Binding SelectedDiffRow}"
                             Background="Transparent"
                             BorderThickness="0"
                             SelectionMode="Single"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             KeyDown="OnDiffListBoxKeyDown"
                             GotFocus="OnDiffRowsListBoxGotFocus">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                            </Style>
                            <Style Selector="ListBoxItem:selected">
                                <Setter Property="Background" Value="#333" />
                            </Style>
                            <Style Selector="ListBoxItem:pointerover">
                                <Setter Property="Background" Value="#2a2a2a" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.DataTemplates>
                            <DataTemplate DataType="{x:Type local:DiffFileHeaderProjection}" x:DataType="local:DiffFileHeaderProjection">
                                <Border Margin="10,10,10,0" Padding="10" Background="#252526" BorderBrush="#333" BorderThickness="1" CornerRadius="4">
                                    <TextBlock Text="{Binding DisplayPath}" Foreground="#4ec9b0" FontWeight="SemiBold" FontSize="13"/>
                                </Border>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type local:DiffHunkHeaderProjection}" x:DataType="local:DiffHunkHeaderProjection">
                                <TextBlock Margin="20,8,10,2"
                                           Text="{Binding Header}"
                                           FontFamily="Cascadia Code,Consolas,Monospace"
                                           FontSize="11"
                                           Foreground="#888"/>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type local:DiffLineProjection}" x:DataType="local:DiffLineProjection">
                                <Grid Margin="20,0,10,1" ColumnDefinitions="56,56,20,*">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding OldLineNoText}"
                                               FontFamily="Cascadia Code,Consolas,Monospace"
                                               FontSize="12"
                                               Foreground="#666"
                                               HorizontalAlignment="Right"
                                               Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding NewLineNoText}"
                                               FontFamily="Cascadia Code,Consolas,Monospace"
                                               FontSize="12"
                                               Foreground="#666"
                                               HorizontalAlignment="Right"
                                               Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Prefix}"
                                               FontFamily="Cascadia Code,Consolas,Monospace"
                                               FontSize="12"
                                               Foreground="{Binding Foreground}"
                                               Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding Content}"
                                               FontFamily="Cascadia Code,Consolas,Monospace"
                                               FontSize="12"
                                               Foreground="{Binding Foreground}"
                                               TextWrapping="NoWrap"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.DataTemplates>
                    </ListBox>
                </Border>

                <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#333" ResizeDirection="Columns"/>

                <Border Grid.Column="2" Background="#252526" BorderBrush="#333" BorderThickness="1,1,0,0" Padding="8">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Files" Foreground="#ddd" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <ListBox x:Name="DiffFilesListBox"
                                 ItemsSource="{Binding SelectedDiffFiles}"
                                 SelectedItem="{Binding SelectedDiffFile}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 SelectionMode="Single"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 KeyDown="OnDiffListBoxKeyDown"
                                 GotFocus="OnDiffFilesListBoxGotFocus">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                </Style>
                                <Style Selector="ListBoxItem:selected">
                                    <Setter Property="Background" Value="#333" />
                                </Style>
                                <Style Selector="ListBoxItem:pointerover">
                                    <Setter Property="Background" Value="#2a2a2a" />
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="local:DiffFileProjection">
                                    <TextBlock Text="{Binding DisplayPath}" Foreground="#ccc" FontSize="12" Margin="6,6,6,6" TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
