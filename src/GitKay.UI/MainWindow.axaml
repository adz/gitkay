<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GitKay.UI"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="GitKay.UI.MainWindow"
        x:DataType="local:MainProjection"
        Title="GitKay">

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Reread refs" Command="{Binding RereadRefs}" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Bottom" Background="#007acc" Padding="4">
            <TextBlock Text="{Binding Status}" Foreground="White" FontSize="12" />
        </Border>

        <Grid RowDefinitions="3*,Auto,5*" MinHeight="0">
            <Border Grid.Row="0" Background="#1e1e1e" BorderBrush="#333" BorderThickness="0,0,0,1">
                <Grid RowDefinitions="Auto,*" MinHeight="0">
                    <Border Grid.Row="0"
                            Background="#252526"
                            BorderBrush="#333"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10"
                            Margin="6,6,6,4">
                        <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
                                <TextBlock Text="Search"
                                           Foreground="#ddd"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="0,0,4,0" />

                                <TextBox Grid.Column="1"
                                         MinWidth="320"
                                         HorizontalAlignment="Stretch"
                                         Text="{Binding SearchQuery, Mode=TwoWay}"
                                         PlaceholderText="Search hash, message, author, path, text, ref">
                                    <TextBox.KeyBindings>
                                        <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
                                    </TextBox.KeyBindings>
                                </TextBox>

                                <ComboBox Grid.Column="2"
                                          Width="160"
                                          ItemsSource="{Binding SearchScopes}"
                                          SelectedItem="{Binding SelectedSearchScope}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="local:SearchScopeProjection">
                                            <TextBlock Text="{Binding Label}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <Button Grid.Column="3"
                                        Content="_Search"
                                        Command="{Binding SearchCommand}" />
                                <Button Grid.Column="4"
                                        Content="_Clear"
                                        Command="{Binding ClearSearchCommand}" />
                            </Grid>

                            <Border Grid.Row="1"
                                    Background="#1f1f1f"
                                    BorderBrush="#333"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8"
                                    IsVisible="{Binding IsSearchPanelExpanded}">
                                <Grid RowDefinitions="Auto,*" RowSpacing="6">
                                    <StackPanel Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="Search results"
                                                       Foreground="#ddd"
                                                       FontWeight="SemiBold"
                                                       FontSize="11" />
                                            <Border Background="#333"
                                                    CornerRadius="999"
                                                    Padding="6,1"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SearchResults.Count}"
                                                           Foreground="#4ec9b0"
                                                           FontSize="11"
                                                           FontWeight="SemiBold" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Results update automatically 1 second after you stop typing. Press Enter to search immediately; the scope menu narrows which fields are matched."
                                                   Foreground="#888"
                                                   FontSize="11"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <ListBox x:Name="SearchResultsListBox"
                                             Grid.Row="1"
                                             ItemsSource="{Binding SearchResults}"
                                             SelectedItem="{Binding SelectedSearchResult}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             SelectionMode="Single"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             MaxHeight="180">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.Styles>
                                            <Style Selector="ListBoxItem">
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="0" />
                                            </Style>
                                            <Style Selector="ListBoxItem:selected">
                                                <Setter Property="Background" Value="#333" />
                                            </Style>
                                            <Style Selector="ListBoxItem:pointerover">
                                                <Setter Property="Background" Value="#2a2a2a" />
                                            </Style>
                                        </ListBox.Styles>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="local:SearchResultProjection">
                                                <Border Padding="8,6">
                                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="3">
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding Subject}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#ddd"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Hash}"
                                                                   Foreground="#888"
                                                                   VerticalAlignment="Center"
                                                                   Margin="10,0,0,0"
                                                                   FontFamily="Cascadia Code,Consolas,Monospace"
                                                                   FontSize="11" />
                                                        <StackPanel Grid.Row="1"
                                                                    Grid.ColumnSpan="2"
                                                                    Orientation="Horizontal"
                                                                    Spacing="12">
                                                            <TextBlock Text="{Binding Author}"
                                                                       Foreground="#aaa"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="11"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Date}"
                                                                       Foreground="#888"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="11" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Row="2"
                                                                    Grid.ColumnSpan="2"
                                                                    Spacing="2">
                                                            <TextBlock Text="{Binding MatchedFieldsLabel}"
                                                                       IsVisible="{Binding HasMatchedFields}"
                                                                       Foreground="#d7ba7d"
                                                                       FontSize="11"
                                                                       TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding MatchedPathsLabel}"
                                                                       IsVisible="{Binding HasMatchedPaths}"
                                                                       Foreground="#9cdcfe"
                                                                       FontSize="11"
                                                                       TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding MatchedRefsLabel}"
                                                                       IsVisible="{Binding HasMatchedRefs}"
                                                                       Foreground="#c586c0"
                                                                       FontSize="11"
                                                                       TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                        <ListBox x:Name="CommitListBox"
                             Grid.Row="1"
                             ItemsSource="{Binding Commits}"
                             SelectedItem="{Binding SelectedCommit}"
                             Background="Transparent"
                             BorderThickness="0"
                             MinHeight="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             KeyDown="OnCommitListBoxKeyDown">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                            </Style>
                            <Style Selector="ListBoxItem:selected">
                                <Setter Property="Background" Value="#333" />
                            </Style>
                            <Style Selector="ListBoxItem:pointerover">
                                <Setter Property="Background" Value="#2a2a2a" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="local:CommitProjection">
                                <Grid ColumnDefinitions="112,72,*,110,110" MinHeight="24" Background="Transparent">
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Create _Tag here..." Command="{Binding CreateTagCommand}" />
                                            <MenuItem Header="Create _Branch here..." Command="{Binding CreateBranchCommand}" />
                                            <Separator />
                                            <MenuItem Header="_Cherry-pick this commit" Command="{Binding CherryPickCommand}" />
                                            <MenuItem Header="_Revert this commit" Command="{Binding RevertCommand}" />
                                            <Separator />
                                            <MenuItem Header="_Reset current branch to here">
                                                <MenuItem Header="_Soft" Command="{Binding ResetSoftCommand}" />
                                                <MenuItem Header="_Hard" Command="{Binding ResetHardCommand}" />
                                            </MenuItem>
                                        </ContextMenu>
                                    </Grid.ContextMenu>

                                    <local:GraphRowControl Grid.Column="0"
                                                           Segments="{Binding Segments}"
                                                           CommitLane="{Binding Lane}"
                                                           Height="24"
                                                           VerticalAlignment="Center" />

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Hash}"
                                               Foreground="#888"
                                               FontSize="10"
                                               Margin="2,0"
                                               VerticalAlignment="Center"
                                               FontFamily="Cascadia Code,Consolas,Monospace" />

                                    <StackPanel Grid.Column="2" Margin="4,0" VerticalAlignment="Center" Spacing="0">
                                        <TextBlock Text="{Binding Subject}"
                                                   FontWeight="SemiBold"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding SecondarySummary}"
                                                   IsVisible="{Binding HasSecondarySummary}"
                                                   Foreground="#9cdcfe"
                                                   FontSize="9"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="3"
                                               Text="{Binding Author}"
                                               Foreground="#aaa"
                                               FontSize="10"
                                               Margin="2,0"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />

                                    <TextBlock Grid.Column="4"
                                               Text="{Binding Date}"
                                               Foreground="#888"
                                               FontSize="10"
                                               Margin="2,0"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

                <Border Grid.Row="1" Background="#252526" BorderBrush="#333" BorderThickness="0,1" Padding="8,6">
                        <StackPanel Spacing="3" IsVisible="{Binding SelectedCommit, Converter={x:Static local:ObjectConverters.IsNotNull}}">
                        <SelectableTextBlock Text="{Binding SelectedCommit.FullHash}" Foreground="#4ec9b0" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Text="{Binding SelectedCommit.RefsSummary}"
                                   IsVisible="{Binding SelectedCommit.HasRefs}"
                                   Foreground="#4ec9b0"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="{Binding SelectedCommit.Author}" Foreground="#aaa" FontSize="12"/>
                            <TextBlock Text="{Binding SelectedCommit.Date}" Foreground="#888" FontSize="12"/>
                        </StackPanel>
                        <SelectableTextBlock Text="{Binding SelectedCommit.Subject}"
                                             FontSize="14"
                                             Foreground="#ddd"
                                             TextTrimming="CharacterEllipsis"
                                             TextWrapping="NoWrap" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Find in commit"
                                       Foreground="#aaa"
                                       FontSize="11"
                                       VerticalAlignment="Center" />
                            <TextBox Width="260"
                                     Text="{Binding CommitFindQuery, Mode=TwoWay}"
                                     PlaceholderText="Search within the selected commit">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding FindInCommitCommand}" />
                                </TextBox.KeyBindings>
                            </TextBox>
                            <Button Content="Find _next"
                                    Command="{Binding FindInCommitCommand}" />
                        </StackPanel>
                    </StackPanel>
            </Border>

            <Grid Grid.Row="2" ColumnDefinitions="*,4,280" Background="#1e1e1e">
                <Border Grid.Column="0" Background="#1e1e1e" BorderBrush="#333" BorderThickness="0,1,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Unified diff"
                                   Foreground="#ddd"
                                   FontWeight="SemiBold"
                                   Margin="10,8,10,6" />
                        <ListBox x:Name="DiffRowsListBox"
                                 ItemsSource="{Binding SelectedDiffRows}"
                                 SelectedItem="{Binding SelectedDiffRow}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 SelectionMode="Single"
                                 MinHeight="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 KeyDown="OnDiffListBoxKeyDown"
                                 GotFocus="OnDiffRowsListBoxGotFocus">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                </Style>
                                <Style Selector="ListBoxItem:selected">
                                    <Setter Property="Background" Value="#333" />
                                </Style>
                                <Style Selector="ListBoxItem:pointerover">
                                    <Setter Property="Background" Value="#2a2a2a" />
                                </Style>
                            </ListBox.Styles>
                            <ListBox.DataTemplates>
                                <DataTemplate DataType="{x:Type local:DiffFileHeaderProjection}" x:DataType="local:DiffFileHeaderProjection">
                                    <Border Margin="10,10,10,0" Padding="10" Background="#252526" BorderBrush="#333" BorderThickness="1" CornerRadius="4">
                                        <TextBlock Text="{Binding DisplayPath}" Foreground="#4ec9b0" FontWeight="SemiBold" FontSize="13"/>
                                    </Border>
                                </DataTemplate>
                                <DataTemplate DataType="{x:Type local:DiffHunkHeaderProjection}" x:DataType="local:DiffHunkHeaderProjection">
                                    <TextBlock Margin="20,8,10,2"
                                               Text="{Binding Header}"
                                               FontFamily="Cascadia Code,Consolas,Monospace"
                                               FontSize="11"
                                               Foreground="#888"/>
                                </DataTemplate>
                                <DataTemplate DataType="{x:Type local:DiffLineProjection}" x:DataType="local:DiffLineProjection">
                                    <Grid Margin="20,0,10,1"
                                          ColumnDefinitions="40,40,16,*"
                                          Background="{Binding RowBackground}">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding OldLineNoText}"
                                                   FontFamily="Cascadia Code,Consolas,Monospace"
                                                   FontSize="10"
                                                   Foreground="#666"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,0,6,0"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding NewLineNoText}"
                                                   FontFamily="Cascadia Code,Consolas,Monospace"
                                                   FontSize="10"
                                                   Foreground="#666"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,0,6,0"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Prefix}"
                                                   FontFamily="Cascadia Code,Consolas,Monospace"
                                                   FontSize="10"
                                                   Foreground="{Binding Foreground}"
                                                   Margin="0,0,4,0"/>
                                        <TextBlock Grid.Column="3"
                                                   FontFamily="Cascadia Code,Consolas,Monospace"
                                                   FontSize="10"
                                                   TextWrapping="NoWrap">
                                            <TextBlock.Inlines>
                                                <Run Text="{Binding MatchPrefix}"
                                                     Foreground="{Binding Foreground}" />
                                                <Run Text="{Binding MatchText}"
                                                     Foreground="{Binding MatchForeground}"
                                                     FontWeight="{Binding MatchFontWeight}"
                                                     TextDecorations="Underline" />
                                                <Run Text="{Binding MatchSuffix}"
                                                     Foreground="{Binding Foreground}" />
                                            </TextBlock.Inlines>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.DataTemplates>
                        </ListBox>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#333" ResizeDirection="Columns"/>

                <Border Grid.Column="2" Background="#252526" BorderBrush="#333" BorderThickness="1,1,0,0" Padding="8">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Files" Foreground="#ddd" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <ListBox x:Name="DiffFilesListBox"
                                 ItemsSource="{Binding SelectedDiffFiles}"
                                 SelectedItem="{Binding SelectedDiffFile}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 SelectionMode="Single"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 KeyDown="OnDiffListBoxKeyDown"
                                 GotFocus="OnDiffFilesListBoxGotFocus">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                </Style>
                                <Style Selector="ListBoxItem:selected">
                                    <Setter Property="Background" Value="#333" />
                                </Style>
                                <Style Selector="ListBoxItem:pointerover">
                                    <Setter Property="Background" Value="#2a2a2a" />
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="local:DiffFileProjection">
                                    <StackPanel Margin="6,6,6,6" Spacing="2">
                                        <TextBlock Text="{Binding DisplayPath}"
                                                   Foreground="#ccc"
                                                   FontSize="12"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding SearchMatchSummary}"
                                                   IsVisible="{Binding HasSearchMatch}"
                                                   Foreground="#d7ba7d"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
