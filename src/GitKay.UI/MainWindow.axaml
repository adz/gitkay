<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GitKay.UI"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="GitKay.UI.MainWindow"
        x:Name="RootWindow"
        x:DataType="local:MainProjection"
        Title="GitKay"
        Background="{DynamicResource GitKayWindowBrush}">

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Reread refs" Command="{Binding RereadRefs}" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Settings..."
                          Click="OnSettingsMenuItemClick" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Show _branch refs"
                          ToggleType="CheckBox"
                          IsChecked="{Binding ShowBranchRefs, Mode=TwoWay}" />
                <MenuItem Header="_Show stashes"
                          ToggleType="CheckBox"
                          IsChecked="{Binding ShowStashes, Mode=TwoWay}" />
                <Separator />
                <MenuItem Header="Show _search panel"
                          ToggleType="CheckBox"
                          IsChecked="{Binding IsSearchPanelExpanded, Mode=TwoWay}" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Bottom" Background="{DynamicResource GitKayStatusBrush}" BorderBrush="{DynamicResource GitKayBorderBrush}" BorderThickness="0,1,0,0" Padding="6,3">
            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource GitKaySecondaryTextBrush}" FontSize="12" />
        </Border>

        <Grid>
        <Grid RowDefinitions="2*,6,3*"
              MinHeight="0">
            <Border Grid.Row="0"
                    Background="{DynamicResource GitKayWindowBrush}"
                    BorderBrush="{DynamicResource GitKayBorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid MinHeight="0"
                      RowDefinitions="Auto,24,*"
                      Grid.IsSharedSizeScope="True">
                    <Border Grid.Row="0"
                            Background="{DynamicResource GitKayRaisedBrush}"
                            BorderBrush="{DynamicResource GitKayBorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="8,6"
                            IsVisible="{Binding IsSearchPanelExpanded}">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto"
                              ColumnSpacing="8">
                            <TextBox x:Name="SearchBox"
                                     MinWidth="320"
                                     HorizontalAlignment="Stretch"
                                     Text="{Binding SearchQuery, Mode=TwoWay}"
                                     PlaceholderText="Search hash, message, author, path, text, ref">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
                                </TextBox.KeyBindings>
                            </TextBox>

                            <ComboBox Grid.Column="1"
                                      Width="160"
                                      ItemsSource="{Binding SearchScopes}"
                                      SelectedItem="{Binding SelectedSearchScope}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="local:SearchScopeProjection">
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <Button Grid.Column="2"
                                    Content="_Search"
                                    Command="{Binding SearchCommand}" />
                            <Button Grid.Column="3"
                                    Content="_Clear"
                                    Command="{Binding ClearSearchCommand}" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Background="{DynamicResource GitKayRaisedBrush}"
                            BorderBrush="{DynamicResource GitKayBorderBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid x:Name="HistoryHeaderGrid"
                              Width="{Binding #CommitListBox.Bounds.Width}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" MinWidth="36" />
                                <ColumnDefinition Width="*" MinWidth="120" />
                                <ColumnDefinition Width="54" MinWidth="48" />
                                <ColumnDefinition Width="110" MinWidth="72" />
                                <ColumnDefinition Width="110" MinWidth="90" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="COMMIT" Foreground="{DynamicResource GitKayMutedTextBrush}" FontSize="10" FontWeight="SemiBold" Margin="6,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="HASH" Foreground="{DynamicResource GitKayMutedTextBrush}" FontSize="10" FontWeight="SemiBold" Margin="6,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="AUTHOR" Foreground="{DynamicResource GitKayMutedTextBrush}" FontSize="10" FontWeight="SemiBold" Margin="6,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="DATE" Foreground="{DynamicResource GitKayMutedTextBrush}" FontSize="10" FontWeight="SemiBold" Margin="6,0" VerticalAlignment="Center" />
                            <Border Grid.Column="0" Width="4" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                                    Background="Transparent" Cursor="SizeWestEast" Tag="0"
                                    PointerPressed="OnHistoryColumnResizePointerPressed" PointerMoved="OnHistoryColumnResizePointerMoved"
                                    PointerReleased="OnHistoryColumnResizePointerReleased" PointerCaptureLost="OnHistoryColumnResizePointerCaptureLost" />
                            <Border Grid.Column="1" Width="4" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                                    Background="Transparent" Cursor="SizeWestEast" Tag="1"
                                    PointerPressed="OnHistoryColumnResizePointerPressed" PointerMoved="OnHistoryColumnResizePointerMoved"
                                    PointerReleased="OnHistoryColumnResizePointerReleased" PointerCaptureLost="OnHistoryColumnResizePointerCaptureLost" />
                            <Border Grid.Column="2"
                                    Width="4"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Stretch"
                                    Background="Transparent"
                                    Cursor="SizeWestEast"
                                    Tag="2"
                                    PointerPressed="OnHistoryColumnResizePointerPressed"
                                    PointerMoved="OnHistoryColumnResizePointerMoved"
                                    PointerReleased="OnHistoryColumnResizePointerReleased"
                                    PointerCaptureLost="OnHistoryColumnResizePointerCaptureLost" />
                            <Border Grid.Column="3"
                                    Width="4"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Stretch"
                                    Background="Transparent"
                                    Cursor="SizeWestEast"
                                    Tag="3"
                                    PointerPressed="OnHistoryColumnResizePointerPressed"
                                    PointerMoved="OnHistoryColumnResizePointerMoved"
                                    PointerReleased="OnHistoryColumnResizePointerReleased"
                                    PointerCaptureLost="OnHistoryColumnResizePointerCaptureLost" />
                        </Grid>
                    </Border>

                    <ScrollViewer x:Name="CommitScrollViewer" Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <local:CommitSurfaceControl x:Name="CommitListBox" ItemsSource="{Binding Commits}" SelectedItem="{Binding SelectedCommit, Mode=TwoWay}"
                            GraphWidth="{Binding #HistoryHeaderGrid.ColumnDefinitions[0].ActualWidth}" SubjectWidth="{Binding #HistoryHeaderGrid.ColumnDefinitions[1].ActualWidth}"
                            HashWidth="{Binding #HistoryHeaderGrid.ColumnDefinitions[2].ActualWidth}" AuthorWidth="{Binding #HistoryHeaderGrid.ColumnDefinitions[3].ActualWidth}"
                            DateWidth="{Binding #HistoryHeaderGrid.ColumnDefinitions[4].ActualWidth}" HorizontalAlignment="Stretch" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <GridSplitter Grid.Row="1"
                          Height="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{DynamicResource GitKayBorderBrush}"
                          ResizeDirection="Rows"
                          ResizeBehavior="PreviousAndNext" />

            <Grid Grid.Row="2"
                  RowDefinitions="Auto,*"
                  MinHeight="0">
                    <Border Grid.Row="0"
                        Background="{DynamicResource GitKaySurfaceBrush}"
                        BorderBrush="{DynamicResource GitKayBorderBrush}"
                        BorderThickness="0,1"
                        Padding="10,6">
                    <Grid RowDefinitions="Auto,Auto"
                          ColumnDefinitions="*,Auto"
                          RowSpacing="5"
                          ColumnSpacing="16"
                          IsVisible="{Binding SelectedCommit, Converter={x:Static local:ObjectConverters.IsNotNull}}">
                        <SelectableTextBlock Grid.Row="0"
                                             Text="{Binding SelectedCommit.Subject}"
                                             FontSize="14"
                                             FontWeight="SemiBold"
                                             Foreground="{DynamicResource GitKayTextBrush}"
                                             TextTrimming="CharacterEllipsis"
                                             TextWrapping="NoWrap" />

                        <StackPanel Grid.Row="0" Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedCommit.Author}"
                                       Foreground="{DynamicResource GitKaySecondaryTextBrush}"
                                       FontSize="11" />
                            <TextBlock Text="·" Foreground="{DynamicResource GitKayMutedTextBrush}" FontSize="11" />
                            <TextBlock Text="{Binding SelectedCommit.Date}"
                                       Foreground="{DynamicResource GitKayMutedTextBrush}"
                                       FontSize="11" />
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center"
                                    ClipToBounds="True">
                            <SelectableTextBlock Text="{Binding SelectedCommit.Hash}"
                                                 Foreground="{DynamicResource GitKayAccentBrush}"
                                                 FontFamily="Cascadia Code,Consolas,Monospace"
                                                 FontSize="11" />
                            <ItemsControl ItemsSource="{Binding SelectedCommit.RefBadges}"
                                          IsVisible="{Binding SelectedCommit.HasRefBadges}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:CommitRefProjection">
                                        <Border Background="{Binding Background}"
                                                BorderBrush="{Binding BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="3"
                                                Padding="5,1"
                                                Margin="0,0,3,0">
                                            <TextBlock Text="{Binding Text}"
                                                       Foreground="{Binding Foreground}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="6">
                            <TextBox x:Name="CommitFindBox"
                                     Width="220"
                                     Height="28"
                                     Text="{Binding CommitFindQuery, Mode=TwoWay}"
                                     PlaceholderText="Find in selected commit">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding FindInCommitCommand}" />
                                </TextBox.KeyBindings>
                            </TextBox>
                            <Button Content="Find next"
                                    Height="28"
                                    Padding="10,2"
                                    Command="{Binding FindInCommitCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1"
                      ColumnDefinitions="*,4,220"
                      Background="{DynamicResource GitKayWindowBrush}">
                    <Border Grid.Column="0" Background="{DynamicResource GitKayWindowBrush}" BorderBrush="{DynamicResource GitKayBorderBrush}" BorderThickness="0,1,0,0">
                        <DockPanel>
                            <Border DockPanel.Dock="Top"
                                    Background="{DynamicResource GitKayRaisedBrush}"
                                    BorderBrush="{DynamicResource GitKayBorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="10,6">
                                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="4">
                                    <TextBlock Text="{Binding SelectedDiffFile.DisplayPath}"
                                               Foreground="{DynamicResource GitKayTextBrush}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />

                                    <TextBlock Grid.Column="1" Text="View" Foreground="{DynamicResource GitKaySecondaryTextBrush}" FontSize="11" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="2" Width="132" Height="28"
                                              ItemsSource="{Binding DiffPresentationModes}"
                                              SelectedItem="{Binding SelectedDiffPresentationMode}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="local:DiffPresentationModeProjection">
                                                <TextBlock Text="{Binding Label}" FontSize="11" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <TextBlock Grid.Column="3" Text="Context" Foreground="{DynamicResource GitKaySecondaryTextBrush}" FontSize="11" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="4" Width="86" Height="28"
                                              ItemsSource="{Binding DiffContextLineCounts}"
                                              SelectedItem="{Binding SelectedDiffContextLineCount}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="local:DiffContextLineCountProjection">
                                                <TextBlock Text="{Binding Label}" FontSize="11" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <Border Grid.Row="1" Grid.ColumnSpan="5"
                                            Background="{DynamicResource GitKayAccentMutedBrush}"
                                            CornerRadius="3" Padding="6,2"
                                            IsVisible="{Binding HasDiffSearchStatus}">
                                        <TextBlock Text="{Binding DiffSearchStatusText}"
                                                   Foreground="{Binding DiffSearchStatusForeground}"
                                                   FontSize="11" />
                                    </Border>
                                </Grid>
                            </Border>
                            <ScrollViewer x:Name="DiffRowsScrollViewer"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <local:DiffSurfaceControl x:Name="DiffRowsListBox"
                                                          ItemsSource="{Binding SelectedDiffRows}"
                                                          SelectedItem="{Binding SelectedDiffRow, Mode=TwoWay}"
                                                          Mode="{Binding SelectedDiffPresentationMode.Key}"
                                                          ExpandBlockCommand="{Binding ExpandDiffBlockCommand}"
                                                          ExpandGapCommand="{Binding ExpandDiffGapCommand}"
                                                          HorizontalAlignment="Stretch"
                                                          GotFocus="OnDiffRowsListBoxGotFocus" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <GridSplitter Grid.Column="1"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Background="{DynamicResource GitKayBorderBrush}"
                                  ResizeDirection="Columns"
                                  ResizeBehavior="PreviousAndNext" />

                    <Border Grid.Column="2"
                            MinWidth="200"
                            Background="{DynamicResource GitKaySurfaceBrush}"
                            BorderBrush="{DynamicResource GitKayBorderBrush}"
                            BorderThickness="1,1,0,0"
                            Padding="8">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="CHANGED FILES" Foreground="{DynamicResource GitKayMutedTextBrush}" FontSize="10" FontWeight="SemiBold" Margin="4,2,4,8"/>
                            <ListBox x:Name="DiffFilesListBox"
                                     ItemsSource="{Binding SelectedDiffFiles}"
                                     SelectedItem="{Binding SelectedDiffFile}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     SelectionMode="Single"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     GotFocus="OnDiffFilesListBoxGotFocus">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                    </Style>
                                    <Style Selector="ListBoxItem:selected">
                                        <Setter Property="Background" Value="{DynamicResource GitKaySelectionBrush}" />
                                    </Style>
                                    <Style Selector="ListBoxItem:pointerover">
                                        <Setter Property="Background" Value="{DynamicResource GitKayHoverBrush}" />
                                    </Style>
                                </ListBox.Styles>
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="local:DiffFileProjection">
                                        <Border Padding="8,6"
                                                Background="{Binding RowBackground}"
                                                BorderThickness="0">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="7">
                                                <TextBlock Text="{Binding DisplayPath}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource GitKayTextBrush}"
                                                           TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding SearchMatchSummary}"
                                                           IsVisible="{Binding HasSearchMatch}"
                                                           Foreground="{DynamicResource GitKayAccentBrush}"
                                                           FontSize="10"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <Grid IsVisible="{Binding IsInitialLoading}"
              Background="{DynamicResource GitKayWindowBrush}"
              RowDefinitions="2*,6,3*"
              Panel.ZIndex="10"
              IsHitTestVisible="False">
            <Border Background="{DynamicResource GitKayWindowBrush}"
                    BorderBrush="{DynamicResource GitKayBorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid RowDefinitions="24,*">
                    <Border Background="{DynamicResource GitKayRaisedBrush}" />
                    <StackPanel Grid.Row="1" Margin="56,14,24,0" Spacing="12">
                        <Border Width="420" Height="8" HorizontalAlignment="Left" CornerRadius="4" Background="{DynamicResource GitKayRaisedBrush}" />
                        <Border Width="570" Height="8" HorizontalAlignment="Left" CornerRadius="4" Background="{DynamicResource GitKayRaisedBrush}" />
                        <Border Width="360" Height="8" HorizontalAlignment="Left" CornerRadius="4" Background="{DynamicResource GitKayRaisedBrush}" />
                        <Border Width="510" Height="8" HorizontalAlignment="Left" CornerRadius="4" Background="{DynamicResource GitKayRaisedBrush}" />
                        <Border Width="450" Height="8" HorizontalAlignment="Left" CornerRadius="4" Background="{DynamicResource GitKayRaisedBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Row="2" Background="{DynamicResource GitKaySurfaceBrush}">
                <Grid RowDefinitions="52,*">
                    <Border Background="{DynamicResource GitKayRaisedBrush}" BorderBrush="{DynamicResource GitKayBorderBrush}" BorderThickness="0,0,0,1" />
                    <StackPanel Grid.Row="1" Margin="60,18,24,0" Spacing="11">
                        <Border Width="620" Height="8" HorizontalAlignment="Left" CornerRadius="4" Background="{DynamicResource GitKayRaisedBrush}" />
                        <Border Width="700" Height="8" HorizontalAlignment="Left" CornerRadius="4" Background="{DynamicResource GitKayRaisedBrush}" />
                        <Border Width="540" Height="8" HorizontalAlignment="Left" CornerRadius="4" Background="{DynamicResource GitKayRaisedBrush}" />
                        <Border Width="650" Height="8" HorizontalAlignment="Left" CornerRadius="4" Background="{DynamicResource GitKayRaisedBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        </Grid>
    </DockPanel>
</Window>
