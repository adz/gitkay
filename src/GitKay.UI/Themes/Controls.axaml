<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GitKay.UI">
    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource GitKayWindowBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource GitKayTextBrush}" />
        <Setter Property="FontFamily" Value="{x:Static local:FontStacks.Ui}" />
    </Style>
    <Style Selector="Menu">
        <Setter Property="Background" Value="{DynamicResource GitKaySurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource GitKayTextBrush}" />
    </Style>
    <Style Selector="TextBox">
        <Setter Property="Background" Value="{DynamicResource GitKayRaisedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource GitKayTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GitKayBorderBrush}" />
    </Style>
    <!-- Hover keeps the field's own fill and just picks up an accent edge, like a pane's hover. -->
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource GitKayRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GitKayHoverEdgeBrush}" />
    </Style>
    <Style Selector="ComboBox:pointerover /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource GitKayRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GitKayHoverEdgeBrush}" />
    </Style>
    <Style Selector="ComboBox">
        <Setter Property="Background" Value="{DynamicResource GitKayRaisedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource GitKayTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GitKayBorderBrush}" />
    </Style>
    <Style Selector="Button">
        <Setter Property="Background" Value="{DynamicResource GitKayRaisedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource GitKayTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GitKayBorderBrush}" />
    </Style>
    <!--
      One colour per state. The Fluent theme paints its own brushes on the template part, so without these a hover
      crossfades between two different colours and looks like it flashes.
    -->
    <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource GitKayRaisedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource GitKayTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GitKayBorderBrush}" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource GitKayControlHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource GitKayTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GitKayHoverEdgeBrush}" />
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource GitKaySelectionBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource GitKayTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GitKayHoverEdgeBrush}" />
    </Style>
    <!-- Segmented icon toggles (diff view modes, file list modes). -->
    <Style Selector="Button.segment">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Opacity" Value="0.7" />
    </Style>
    <Style Selector="Button.segment:pointerover">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.segment:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource GitKayHoverBrush}" />
    </Style>
    <Style Selector="Button.segment.selected">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.segment.selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource GitKayHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GitKayAccentBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,2" />
    </Style>
    <Style Selector="Button.segment.text, ToggleButton.segment.text">
        <Setter Property="Width" Value="NaN" />
        <Setter Property="Padding" Value="9,0" />
    </Style>
    <Style Selector="ToggleButton.segment">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Opacity" Value="0.7" />
    </Style>
    <Style Selector="ToggleButton.segment:pointerover">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="ToggleButton.segment:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource GitKayHoverBrush}" />
    </Style>
    <Style Selector="ToggleButton.segment:checked">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="ToggleButton.segment:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource GitKayHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GitKayAccentBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,2" />
        <Setter Property="Foreground" Value="{DynamicResource GitKayTextBrush}" />
    </Style>
    <Style Selector="Button.inline, Button.funnel">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <!-- A folder path that can be clicked to change it: it reads as a field, not as a button. -->
    <Style Selector="Button.pathChip">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Background" Value="{DynamicResource GitKayRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GitKayBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.pathChip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource GitKayControlHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GitKayHoverEdgeBrush}" />
    </Style>

    <Style Selector="ToggleButton.inline">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="20" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Opacity" Value="0.65" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleButton.inline:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource GitKayHoverBrush}" />
    </Style>
    <Style Selector="ToggleButton.inline:checked">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="ToggleButton.inline:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource GitKaySelectionBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource GitKayTextBrush}" />
    </Style>
    <Style Selector="Button.funnel">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
    </Style>
    <Style Selector="Button.inline:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.funnel:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource GitKayHoverBrush}" />
    </Style>
    <Style Selector="ToggleButton.expander">
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource GitKaySecondaryTextBrush}" />
    </Style>
    <Style Selector="ToggleButton.expander:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.expander:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource GitKayHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource GitKayTextBrush}" />
    </Style>
    <Style Selector="Button.commitLink">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4,1" />
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource GitKayAccentBrush}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.commitLink:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource GitKayHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource GitKayAccentBrush}" />
    </Style>
    <!-- Tooltips stay a readable column and wrap; a commit message is otherwise one very long line. -->
    <Style Selector="ToolTip">
        <Setter Property="MaxWidth" Value="720" />
    </Style>
    <Style Selector="ToolTip > TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Splitters don't react to the pointer at all: the hairline behind them marks the edge, and it stays put. -->
    <Style Selector="GridSplitter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- Hover and press land on one colour straight away: crossfading between two themes' brushes reads as a flash. -->
    <Style Selector="ListBoxItem /template/ ContentPresenter#PART_ContentPresenter, Button /template/ ContentPresenter#PART_ContentPresenter, ToggleButton /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Transitions">
            <Transitions />
        </Setter>
    </Style>
    <Style Selector=":is(Control).fadeIn[IsVisible=True]">
        <Style.Animations>
            <Animation Duration="0:0:0.1" FillMode="Forward">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Muted ref pills (commit details); the commit list draws the same colours. -->
    <Style Selector="Border.refPill">
        <Setter Property="Background" Value="{DynamicResource GitKayRefBranchBackground}" />
    </Style>
    <Style Selector="Border.refPill > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource GitKayRefBranchForeground}" />
    </Style>
    <Style Selector="Border.refPill.remote"><Setter Property="Background" Value="{DynamicResource GitKayRefRemoteBackground}" /></Style>
    <Style Selector="Border.refPill.remote > TextBlock"><Setter Property="Foreground" Value="{DynamicResource GitKayRefRemoteForeground}" /></Style>
    <Style Selector="Border.refPill.tag"><Setter Property="Background" Value="{DynamicResource GitKayRefTagBackground}" /></Style>
    <Style Selector="Border.refPill.tag > TextBlock"><Setter Property="Foreground" Value="{DynamicResource GitKayRefTagForeground}" /></Style>
    <Style Selector="Border.refPill.stash"><Setter Property="Background" Value="{DynamicResource GitKayRefStashBackground}" /></Style>
    <Style Selector="Border.refPill.stash > TextBlock"><Setter Property="Foreground" Value="{DynamicResource GitKayRefStashForeground}" /></Style>

    <!-- Segment groups carry no outline: only the selected segment is tinted, which keeps bars quiet. -->
    <!-- Ctrl-held shortcut hints. -->
    <Style Selector="Border.keyHint">
        <Setter Property="Background" Value="{DynamicResource GitKayAccentBrush}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="5,1" />
        <Setter Property="ZIndex" Value="50" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="BoxShadow" Value="0 2 6 0 #40000000" />
    </Style>
    <Style Selector="Border.keyHint > TextBlock">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.segmentGroup">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="0" />
    </Style>
</Styles>
