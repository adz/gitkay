<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GitKay.UI"
        mc:Ignorable="d"
        x:Class="GitKay.UI.SettingsWindow"
        x:Name="SettingsRoot"
        x:DataType="local:MainProjection"
        Title="Settings"
        Width="760"
        Height="560"
        MinWidth="640"
        MinHeight="460"
        CanResize="True"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,16,0,0">
            <Button Content="_Close"
                    IsDefault="True"
                    Click="OnCloseClick" />
        </StackPanel>

        <TabControl>
            <TabItem Header="General">
                <ScrollViewer>
                    <StackPanel Spacing="12" Margin="0,8,0,0">
                        <TextBlock Text="Application-wide preferences."
                                   Foreground="{DynamicResource GitKaySecondaryTextBrush}" />

                        <GroupBox Header="Appearance">
                            <Border Padding="12">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="Theme"
                                               Foreground="{DynamicResource GitKayTextBrush}"
                                               VerticalAlignment="Center" />
                                    <ComboBox Width="150"
                                              ItemsSource="{Binding ThemeModes}"
                                              SelectedItem="{Binding SelectedThemeMode}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="local:ThemeModeProjection">
                                                <TextBlock Text="{Binding Label}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Border>
                        </GroupBox>

                        <GroupBox Header="Panes">
                            <Border Padding="12">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="Space around panes"
                                                   Foreground="{DynamicResource GitKayTextBrush}"
                                                   VerticalAlignment="Center" />
                                        <NumericUpDown Width="110" Minimum="0" Maximum="8" Increment="1" FormatString="0"
                                                       Value="{Binding PaneGap, Mode=TwoWay}" />
                                        <TextBlock Text="pixels"
                                                   Foreground="{DynamicResource GitKaySecondaryTextBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="Effect colour"
                                                   Foreground="{DynamicResource GitKayTextBrush}"
                                                   VerticalAlignment="Center" />
                                        <ComboBox Width="150"
                                                  ItemsSource="{Binding PaneHoverColors}"
                                                  SelectedItem="{Binding SelectedPaneHoverColor}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="local:PaneHoverColorProjection">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Border Width="14" Height="14" CornerRadius="3" Background="{Binding Swatch}" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="On hover"
                                                   Foreground="{DynamicResource GitKayTextBrush}"
                                                   VerticalAlignment="Center" />
                                        <ComboBox Width="150"
                                                  ItemsSource="{Binding PaneHoverEffects}"
                                                  SelectedItem="{Binding SelectedPaneHoverEffect}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="local:PaneHoverEffectProjection">
                                                    <TextBlock Text="{Binding Label}" ToolTip.Tip="{Binding Description}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock Text="{Binding SelectedPaneHoverEffect.Description}"
                                                   Foreground="{DynamicResource GitKaySecondaryTextBrush}"
                                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="History">
                <ScrollViewer>
                    <StackPanel Spacing="12" Margin="0,8,0,0">
                        <TextBlock Text="Controls for the commit history view."
                                   Foreground="{DynamicResource GitKaySecondaryTextBrush}" />

                        <GroupBox Header="Ref badges">
                            <Border Padding="12">
                                <StackPanel Spacing="8">
                                    <CheckBox Content="Show branch refs"
                                              IsChecked="{Binding ShowBranchRefs, Mode=TwoWay}" />
                                    <CheckBox Content="Show stashes"
                                              IsChecked="{Binding ShowStashes, Mode=TwoWay}" />
                                </StackPanel>
                            </Border>
                        </GroupBox>

                        <GroupBox Header="Navigation">
                            <Border Padding="12">
                                <StackPanel Spacing="4">
                                    <CheckBox Content="Hover to focus"
                                              IsChecked="{Binding HoverToFocus, Mode=TwoWay}" />
                                    <TextBlock Text="Pointing at the commit list, diff or file list makes it the target for keyboard shortcuts — e.g. hover the diff and press Ctrl+F to find in the diff. Doesn't take focus away from a text box you're typing in."
                                               TextWrapping="Wrap" FontSize="12"
                                               Foreground="{DynamicResource GitKaySecondaryTextBrush}" />
                                </StackPanel>
                            </Border>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Commit">
                <ScrollViewer>
                    <StackPanel Spacing="12" Margin="0,8,0,0">
                        <TextBlock Text="Typography used by the commit list and commit header."
                                   Foreground="{DynamicResource GitKaySecondaryTextBrush}" />

                        <GroupBox Header="Row typography">
                            <Border Padding="12">
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                      ColumnDefinitions="*,180"
                                      RowSpacing="10"
                                      ColumnSpacing="12">
                                    <TextBlock Grid.Row="0"
                                               Text="Font family"
                                               Foreground="{DynamicResource GitKayTextBrush}" />
                                    <TextBox Grid.Row="0"
                                             Grid.Column="1"
                                             Text="{Binding CommitRowFontFamily, Mode=TwoWay}" />

                                    <TextBlock Grid.Row="1"
                                               Text="Mono font family"
                                               Foreground="{DynamicResource GitKayTextBrush}" />
                                    <TextBox Grid.Row="1"
                                             Grid.Column="1"
                                             Text="{Binding CommitRowMonoFontFamily, Mode=TwoWay}" />

                                    <TextBlock Grid.Row="2"
                                               Text="Subject font size"
                                               Foreground="{DynamicResource GitKayTextBrush}" />
                                    <TextBox Grid.Row="2"
                                             Grid.Column="1"
                                             Text="{Binding CommitRowTextFontSize, Mode=TwoWay}" />

                                    <TextBlock Grid.Row="3"
                                               Text="Meta font size"
                                               Foreground="{DynamicResource GitKayTextBrush}" />
                                    <TextBox Grid.Row="3"
                                             Grid.Column="1"
                                             Text="{Binding CommitRowMetaFontSize, Mode=TwoWay}" />

                                    <TextBlock Grid.Row="4"
                                               Text="Badge font size"
                                               Foreground="{DynamicResource GitKayTextBrush}" />
                                    <TextBox Grid.Row="4"
                                             Grid.Column="1"
                                             Text="{Binding CommitRowBadgeFontSize, Mode=TwoWay}" />
                                </Grid>
                            </Border>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Diff">
                <ScrollViewer>
                    <StackPanel Spacing="12" Margin="0,8,0,0">
                        <TextBlock Text="Presentation and search behavior for the diff view."
                                   Foreground="{DynamicResource GitKaySecondaryTextBrush}" />

                        <GroupBox Header="Diff presentation">
                            <Border Padding="12">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="Mode"
                                                   Foreground="{DynamicResource GitKayTextBrush}"
                                                   VerticalAlignment="Center" />
                                        <ComboBox Width="180"
                                                  ItemsSource="{Binding DiffPresentationModes}"
                                                  SelectedItem="{Binding SelectedDiffPresentationMode}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="local:DiffPresentationModeProjection">
                                                    <TextBlock Text="{Binding Label}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="Context lines"
                                                   Foreground="{DynamicResource GitKayTextBrush}"
                                                   VerticalAlignment="Center" />
                                        <ComboBox Width="150"
                                                  ItemsSource="{Binding DiffContextLineCounts}"
                                                  SelectedItem="{Binding SelectedDiffContextLineCount}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="local:DiffContextLineCountProjection">
                                                    <TextBlock Text="{Binding Label}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="Search debounce"
                                                   Foreground="{DynamicResource GitKayTextBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBox Width="88"
                                                 Text="{Binding SearchDebounceSeconds, Mode=TwoWay}" />
                                        <TextBlock Text="seconds"
                                                   Foreground="{DynamicResource GitKaySecondaryTextBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
