<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GitKay.UI"
        mc:Ignorable="d"
        x:Class="GitKay.UI.SettingsWindow"
        x:Name="SettingsRoot"
        x:DataType="local:MainProjection"
        Title="Settings"
        Width="980"
        Height="680"
        MinWidth="860"
        MinHeight="600"
        CanResize="True"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,16,0,0">
            <Button Content="_Close"
                    IsDefault="True"
                    Click="OnCloseClick" />
        </StackPanel>

        <TabControl>
            <TabItem Header="General">
                <ScrollViewer>
                    <StackPanel Spacing="12" Margin="0,8,0,0">
                        <TextBlock Text="Application-wide preferences."
                                   Foreground="{DynamicResource GitKaySecondaryTextBrush}" />

                        <GroupBox Header="Appearance">
                            <Border Padding="12">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="Theme"
                                               Foreground="{DynamicResource GitKayTextBrush}"
                                               VerticalAlignment="Center" />
                                    <ComboBox Width="150"
                                              ItemsSource="{Binding ThemeModes}"
                                              SelectedItem="{Binding SelectedThemeMode}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="local:ThemeModeProjection">
                                                <TextBlock Text="{Binding Label}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Border>
                        </GroupBox>

                        <GroupBox Header="Panes">
                            <Border Padding="12">
                                <!-- Labels in one column and inputs in the next, so the fields line up down the panel. -->
                                <Grid ColumnDefinitions="150,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="10">
                                    <TextBlock Text="Space around panes" Foreground="{DynamicResource GitKayTextBrush}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <NumericUpDown Width="120" Minimum="0" Maximum="8" Increment="1" FormatString="0"
                                                       Value="{Binding PaneGap, Mode=TwoWay}" />
                                        <TextBlock Text="pixels" Foreground="{DynamicResource GitKaySecondaryTextBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="2" Content="Hide the line between panes" IsChecked="{Binding SplitterLinesHidden, Mode=TwoWay}" VerticalAlignment="Center"
                                              ToolTip.Tip="The splitter can still be dragged; it just isn't drawn" />

                                    <TextBlock Grid.Row="1" Text="Focus" Foreground="{DynamicResource GitKayTextBrush}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="16">
                                        <CheckBox Content="Hover focuses" IsChecked="{Binding HoverToFocus, Mode=TwoWay}"
                                                  ToolTip.Tip="Pointing at a pane makes it the target for keys, without clicking" />
                                        <CheckBox Content="Dim the other panes" IsChecked="{Binding PaneDimUnfocused, Mode=TwoWay}"
                                                  ToolTip.Tip="Wash over the panes without the keys, so the focused one stands out" />
                                    </StackPanel>
                                    <CheckBox Grid.Row="1" Grid.Column="2" Content="Highlight its edge" IsChecked="{Binding PaneFocusHighlight, Mode=TwoWay}" VerticalAlignment="Center" />

                                    <TextBlock Grid.Row="2" Text="On focus" Foreground="{DynamicResource GitKayTextBrush}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <ComboBox Width="150"
                                                  ItemsSource="{Binding PaneFocusEffects}"
                                                  SelectedItem="{Binding SelectedPaneFocusEffect}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="local:PaneFocusEffectProjection">
                                                    <TextBlock Text="{Binding Label}" ToolTip.Tip="{Binding Description}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <ComboBox Width="122"
                                                  ItemsSource="{Binding PaneHoverIntensities}"
                                                  SelectedItem="{Binding SelectedPaneEffectIntensity}"
                                                  ToolTip.Tip="How strong the effect is">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="local:PaneEffectIntensityProjection">
                                                    <TextBlock Text="{Binding Label}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding SelectedPaneFocusEffect.Description}"
                                               Foreground="{DynamicResource GitKaySecondaryTextBrush}"
                                               VerticalAlignment="Center" TextWrapping="Wrap" />

                                    <TextBlock Grid.Row="3" Text="Effect colour" Foreground="{DynamicResource GitKayTextBrush}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Row="3" Grid.Column="1" Width="280" HorizontalAlignment="Left"
                                              ItemsSource="{Binding PaneEffectColors}"
                                              SelectedItem="{Binding SelectedPaneEffectColor}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="local:PaneEffectColorProjection">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Border Width="14" Height="14" CornerRadius="3" Background="{Binding Swatch}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <TextBlock Grid.Row="4" Text="Outline" Foreground="{DynamicResource GitKayTextBrush}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <CheckBox Content="Bordered" IsChecked="{Binding PaneBorder, Mode=TwoWay}" VerticalAlignment="Center"
                                                  ToolTip.Tip="Draw a border around each pane, so the space reads as a frame" />
                                        <ComboBox Width="110" IsEnabled="{Binding PaneBorder}"
                                                  ItemsSource="{Binding PaneBorderStyles}"
                                                  SelectedItem="{Binding SelectedPaneBorderStyle}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="local:PaneBorderStyleProjection">
                                                    <TextBlock Text="{Binding Label}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Row="4" Grid.Column="2" Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsCustomPaneBorder}">
                                        <ComboBox Width="170" IsEnabled="{Binding PaneBorder}"
                                                  ItemsSource="{Binding PaneBorderColors}"
                                                  SelectedItem="{Binding SelectedPaneBorderColor}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="local:PaneEffectColorProjection">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Border Width="14" Height="14" CornerRadius="3" Background="{Binding Swatch}" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <NumericUpDown Width="110" Minimum="1" Maximum="4" Increment="1" FormatString="0"
                                                       IsEnabled="{Binding PaneBorder}"
                                                       Value="{Binding PaneBorderThickness, Mode=TwoWay}" />
                                        <TextBlock Text="pixels" Foreground="{DynamicResource GitKaySecondaryTextBrush}" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <TextBlock Grid.Row="5" Text="Chrome" Foreground="{DynamicResource GitKayTextBrush}" VerticalAlignment="Center"
                                               ToolTip.Tip="The toolbar, the column headers and the bar above each pane" />
                                    <ComboBox Grid.Row="5" Grid.Column="1" Width="150" HorizontalAlignment="Left"
                                              ItemsSource="{Binding ChromeBackgrounds}"
                                              SelectedItem="{Binding SelectedChromeBackground}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="local:ChromeBackgroundProjection">
                                                <TextBlock Text="{Binding Label}" ToolTip.Tip="{Binding Description}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <StackPanel Grid.Row="5" Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <ComboBox Width="170" IsVisible="{Binding IsTintedChrome}"
                                                  ItemsSource="{Binding ChromeColors}"
                                                  SelectedItem="{Binding SelectedChromeColor}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="local:PaneEffectColorProjection">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Border Width="14" Height="14" CornerRadius="3" Background="{Binding Swatch}" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock Text="{Binding SelectedChromeBackground.Description}" IsVisible="{Binding !IsTintedChrome}"
                                                   Foreground="{DynamicResource GitKaySecondaryTextBrush}"
                                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="History">
                <ScrollViewer>
                    <StackPanel Spacing="12" Margin="0,8,0,0">
                        <TextBlock Text="Controls for the commit history view."
                                   Foreground="{DynamicResource GitKaySecondaryTextBrush}" />

                        <GroupBox Header="Ref badges">
                            <Border Padding="12">
                                <StackPanel Spacing="8">
                                    <CheckBox Content="Show branch refs"
                                              IsChecked="{Binding ShowBranchRefs, Mode=TwoWay}" />
                                    <CheckBox Content="Show stashes"
                                              IsChecked="{Binding ShowStashes, Mode=TwoWay}" />
                                </StackPanel>
                            </Border>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Commit">
                <ScrollViewer>
                    <StackPanel Spacing="12" Margin="0,8,0,0">
                        <TextBlock Text="Typography used by the commit list and commit header."
                                   Foreground="{DynamicResource GitKaySecondaryTextBrush}" />

                        <GroupBox Header="Row typography">
                            <Border Padding="12">
                                <!-- Labels in one column and inputs in the next, so the fields line up down the panel. -->
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                      ColumnDefinitions="150,Auto,*"
                                      RowSpacing="10"
                                      ColumnSpacing="12">
                                    <TextBlock Text="Font family" Foreground="{DynamicResource GitKayTextBrush}" VerticalAlignment="Center" />
                                    <AutoCompleteBox Grid.Column="1" Width="280" HorizontalAlignment="Left"
                                                     FilterMode="Contains" MinimumPrefixLength="0" MaxDropDownHeight="320"
                                                     ItemsSource="{Binding InstalledFonts}"
                                                     ValueMemberBinding="{Binding Name}"
                                                     Text="{Binding CommitRowFontFamily, Mode=TwoWay}"
                                                     ToolTip.Tip="Pick an installed font, or type a comma-separated stack to fall back through">
                                        <AutoCompleteBox.ItemTemplate>
                                            <DataTemplate x:DataType="local:InstalledFont">
                                                <TextBlock Text="{Binding Name}" FontFamily="{Binding Family}" FontSize="14" />
                                            </DataTemplate>
                                        </AutoCompleteBox.ItemTemplate>
                                    </AutoCompleteBox>
                                    <TextBlock Grid.Column="2" Text="Sat quick brown fox 0123" FontFamily="{Binding CommitRowFont}"
                                               Foreground="{DynamicResource GitKaySecondaryTextBrush}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                    <TextBlock Grid.Row="1" Text="Mono font family" Foreground="{DynamicResource GitKayTextBrush}" VerticalAlignment="Center" />
                                    <AutoCompleteBox Grid.Row="1" Grid.Column="1" Width="280" HorizontalAlignment="Left"
                                                     FilterMode="Contains" MinimumPrefixLength="0" MaxDropDownHeight="320"
                                                     ItemsSource="{Binding InstalledMonoFonts}"
                                                     ValueMemberBinding="{Binding Name}"
                                                     Text="{Binding CommitRowMonoFontFamily, Mode=TwoWay}"
                                                     ToolTip.Tip="Only fixed-width families are listed; type a name to use one that isn't">
                                        <AutoCompleteBox.ItemTemplate>
                                            <DataTemplate x:DataType="local:InstalledFont">
                                                <TextBlock Text="{Binding Name}" FontFamily="{Binding Family}" FontSize="14" />
                                            </DataTemplate>
                                        </AutoCompleteBox.ItemTemplate>
                                    </AutoCompleteBox>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="fn hash(0) -> Ill1|O0" FontFamily="{Binding CommitRowMonoFont}"
                                               Foreground="{DynamicResource GitKaySecondaryTextBrush}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                    <TextBlock Grid.Row="2" Text="Subject font size" Foreground="{DynamicResource GitKayTextBrush}" VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Row="2" Grid.Column="1" Width="120" HorizontalAlignment="Left"
                                                   Minimum="6" Maximum="40" Increment="1" FormatString="0.#"
                                                   Value="{Binding CommitRowTextFontSize, Mode=TwoWay}" />

                                    <TextBlock Grid.Row="3" Text="Meta font size" Foreground="{DynamicResource GitKayTextBrush}" VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Row="3" Grid.Column="1" Width="120" HorizontalAlignment="Left"
                                                   Minimum="6" Maximum="40" Increment="1" FormatString="0.#"
                                                   Value="{Binding CommitRowMetaFontSize, Mode=TwoWay}" />

                                    <TextBlock Grid.Row="4" Text="Badge font size" Foreground="{DynamicResource GitKayTextBrush}" VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Row="4" Grid.Column="1" Width="120" HorizontalAlignment="Left"
                                                   Minimum="6" Maximum="40" Increment="1" FormatString="0.#"
                                                   Value="{Binding CommitRowBadgeFontSize, Mode=TwoWay}" />
                                </Grid>
                            </Border>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Diff">
                <ScrollViewer>
                    <StackPanel Spacing="12" Margin="0,8,0,0">
                        <TextBlock Text="Presentation and search behavior for the diff view."
                                   Foreground="{DynamicResource GitKaySecondaryTextBrush}" />

                        <GroupBox Header="Diff presentation">
                            <Border Padding="12">
                                <!-- Labels in one column and inputs in the next, so the fields line up down the panel. -->
                                <Grid ColumnDefinitions="150,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="10">
                                    <TextBlock Text="Mode" Foreground="{DynamicResource GitKayTextBrush}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" Width="180" HorizontalAlignment="Left"
                                              ItemsSource="{Binding DiffPresentationModes}"
                                              SelectedItem="{Binding SelectedDiffPresentationMode}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="local:DiffPresentationModeProjection">
                                                <TextBlock Text="{Binding Label}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <TextBlock Grid.Row="1" Text="Context lines" Foreground="{DynamicResource GitKayTextBrush}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Row="1" Grid.Column="1" Width="180" HorizontalAlignment="Left"
                                              ItemsSource="{Binding DiffContextLineCounts}"
                                              SelectedItem="{Binding SelectedDiffContextLineCount}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="local:DiffContextLineCountProjection">
                                                <TextBlock Text="{Binding Label}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <TextBlock Grid.Row="2" Text="Markdown" Foreground="{DynamicResource GitKayTextBrush}" VerticalAlignment="Center" />
                                    <CheckBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Content="Render Markdown by default"
                                              IsChecked="{Binding RenderMarkdownByDefault, Mode=TwoWay}" />

                                    <TextBlock Grid.Row="3" Text="Remote images" Foreground="{DynamicResource GitKayTextBrush}" VerticalAlignment="Center" />
                                    <CheckBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Content="Load remote Markdown images"
                                              IsChecked="{Binding LoadRemoteMarkdownImages, Mode=TwoWay}"
                                              ToolTip.Tip="Contacts external hosts and may reveal that you opened the document" />

                                    <TextBlock Grid.Row="4" Text="Rendered diffs" Foreground="{DynamicResource GitKayTextBrush}" VerticalAlignment="Center" />
                                    <CheckBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Content="Collapse long unchanged runs"
                                              IsChecked="{Binding RenderedMarkdownChangesOnly, Mode=TwoWay}" />

                                    <TextBlock Grid.Row="5" Text="Search debounce" Foreground="{DynamicResource GitKayTextBrush}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <NumericUpDown Width="120" Minimum="0" Maximum="5" Increment="0.25" FormatString="0.##"
                                                       Value="{Binding SearchDebounceSeconds, Mode=TwoWay}" />
                                        <TextBlock Text="seconds" Foreground="{DynamicResource GitKaySecondaryTextBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
