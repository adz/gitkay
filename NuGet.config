<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Axial 0.13.0-local.* dogfood feed. Remove this file (or the local source) once Axial 0.13.0 is on nuget.org:
    CI cannot restore from a local folder.
  -->
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="axial-local" value="/home/adam/projects/scratch/axial-coord/feed/axial-0.13.0-local.2" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="axial-local">
      <package pattern="Axial" />
      <package pattern="Axial.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
